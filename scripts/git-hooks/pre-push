#!/usr/bin/env bash
# Validate the exact Git objects selected for a push to the public repository.
# There is intentionally no environment-variable bypass.
set -euo pipefail

remote_name="${1:-}"
remote_url="${2:-}"
zero="0000000000000000000000000000000000000000"

case "$remote_url" in
  *github.com[:/]*0x-abdul/defirisk*) ;;
  *) exit 0 ;;
esac

temporary_roots=()
cleanup() {
  local path
  for path in "${temporary_roots[@]:-}"; do
    [ -n "$path" ] && rm -rf -- "$path"
  done
}
trap cleanup EXIT HUP INT TERM

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue

  temporary_root="$(mktemp -d)"
  temporary_roots+=("$temporary_root")
  git archive "$local_sha" | tar -x -C "$temporary_root"

  validator="$temporary_root/scripts/ci/verify-public-boundary.py"
  if [ ! -f "$validator" ]; then
    echo "BLOCKED: pushed tree does not contain the public boundary validator." >&2
    exit 1
  fi

  if ! python "$validator" --root "$temporary_root"; then
    echo "BLOCKED: $local_ref failed private-safe public boundary validation." >&2
    echo "No branch or Git object should be sent to GitHub until regenerated and revalidated." >&2
    exit 1
  fi
done

exit 0

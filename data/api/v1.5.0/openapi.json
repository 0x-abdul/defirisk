    },
    "/incidents.json": {
      "get": {
        "operationId": "listIncidents",
        "summary": "Active incidents",
        "description": "Active security incidents driving per-protocol presentation banners (PD-033). Does not affect structural letter grades.",
        "tags": [
          "incidents"
        ],
        "responses": {
          "200": {
            "description": "Incidents envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://defirisk.co/api/v1.5.0/schema/envelope.json"
                },
                "example": {
                  "rubric_version": "v1.5.0",
                  "data_as_of": "2026-04-27T05:38:08Z",
                  "generated_at": "2026-04-27T05:38:10Z",
                  "data": {
                    "incidents": []
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rubric.json": {
      "get": {
        "operationId": "getRubric",
        "summary": "Rubric metadata",
        "description": "Frozen rubric metadata: version, frozen_at, changelog_url, notes.",
        "tags": [
          "metadata"
        ],
        "responses": {
          "200": {
            "description": "Rubric envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://defirisk.co/api/v1.5.0/schema/envelope.json"
                },
                "example": {
                  "rubric_version": "v1.5.0",
                  "data_as_of": "2026-04-27T05:38:08Z",
                  "generated_at": "2026-04-27T05:38:10Z",
                  "data": {
                    "version": "v1.5.0",
                    "frozen_at": "2026-04-25T00:00:00Z",
                    "changelog_url": "/methodology/changelog#v1-5-0",
                    "notes": "Launch rubric. 13 categories, 184 factors, 20 critical, 3-value badge layer (PD-033)."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/schema/envelope.json": {
      "get": {
        "operationId": "getEnvelopeSchema",
        "summary": "Envelope JSON Schema",
        "description": "JSON Schema (Draft-07) for the canonical envelope. Every response under /api/v1.5.0/ validates against this.",
        "tags": [
          "metadata"
        ],
        "responses": {
          "200": {
            "description": "JSON Schema document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "$schema": "https://json-schema.org/draft-07/schema#",
                  "$id": "https://defirisk.co/api/v1.5.0/schema/envelope.json",
                  "title": "Risk Dashboard API canonical envelope",
                  "description": "Envelope wrapping every response under /api/v1.5.0/. The `data` field shape varies per endpoint.",
                  "type": "object",
                  "required": [
                    "rubric_version",
                    "data_as_of",
                    "generated_at",
                    "data"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "rubric_version": {
                      "type": "string",
                      "pattern": "^v\\d+\\.\\d+\\.\\d+$",
                      "description": "Frozen rubric version, e.g. v1.5.0.",
                      "example": "v1.5.0"
                    },
                    "data_as_of": {
                      "type": "string",
                      "format": "date-time",
                      "description": "ISO-8601 UTC timestamp of the most recent factor_score collected_at across the payload."
                    },
                    "generated_at": {
                      "type": "string",
                      "format": "date-time",
                      "description": "ISO-8601 UTC timestamp of the deterministic reviewed assessment projection."
                    },
                    "data": {
                      "type": "object",
                      "description": "Endpoint-specific payload. Shape documented per-path in openapi.json."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApiSpec",
        "summary": "OpenAPI 3.1 spec",
        "description": "This document. Machine-readable description of all API paths.",
        "tags": [
          "metadata"
        ],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 specification",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }

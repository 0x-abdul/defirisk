{
  "openapi": "3.1.0",
  "info": {
    "title": "Risk Dashboard Public JSON API",
    "version": "v1.5.0",
    "description": "Read-only static JSON API for the Risk Dashboard.\n\nEvery response is wrapped in the canonical envelope (rubric_version + data_as_of + generated_at + data).\n\nAll data is licensed under CC BY 4.0. No authentication required.\n\nBase path: `https://defirisk.co/api/v1.5.0/`",
    "license": {
      "name": "CC BY 4.0 (data) / MIT (code)",
      "url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "contact": {
      "name": "Risk Dashboard",
      "url": "https://defirisk.co/about/"
    }
  },
  "servers": [
    {
      "url": "https://defirisk.co/api/v1.5.0",
      "description": "Production CDN (Cloudflare Pages)"
    }
  ],
  "paths": {
    "/index.json": {
      "get": {
        "operationId": "listProtocols",
        "summary": "Protocol list",
        "description": "Lightweight index of all graded protocols with headline grade and badge. For full factor scores use the per-slug endpoint.",
        "tags": [
          "protocols"
        ],
        "responses": {
          "200": {
            "description": "Protocol list envelope",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "example": "public, max-age=3600, stale-while-revalidate=86400"
              },
              "Content-Type": {
                "schema": {
                  "type": "string"
                },
                "example": "application/json"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://defirisk.co/api/v1.5.0/schema/envelope.json"
                },
                "example": {
                  "rubric_version": "v1.5.0",
                  "data_as_of": "2026-04-27T05:38:08Z",
                  "generated_at": "2026-04-27T05:38:10Z",
                  "data": {
                    "protocols": [
                      {
                        "slug": "aave-v3",
                        "display_name": "Aave v3",
                        "protocol_type": "lending",
                        "primary_chain": "ethereum",
                        "headline_grade": "F",
                        "headline_badge": "CHRONIC",
                        "total_value_secured_usd": 14063906193,
                        "graded_at": "2026-04-27T02:35:53Z",
                        "rubric_version": "v1.5.0",
                        "status": "live",
                        "has_active_incident": true
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/protocols/{slug}.json": {
      "get": {
        "operationId": "getProtocol",
        "summary": "Protocol detail",
        "description": "Full protocol record: deployments, all 184 factor scores with evidence summaries, and grade history.",
        "tags": [
          "protocols"
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Protocol slug, e.g. `aave-v3`",
            "example": "aave-v3"
          }
        ],
        "responses": {
          "200": {
            "description": "Protocol detail envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://defirisk.co/api/v1.5.0/schema/envelope.json"
                },
                "example": {
                  "rubric_version": "v1.5.0",
                  "data_as_of": "2026-04-27T05:38:08Z",
                  "generated_at": "2026-04-27T05:38:10Z",
                  "data": {
                    "protocol_data": {
                      "protocol": {
                        "slug": "aave-v3",
                        "display_name": "Aave v3",
                        "protocol_type": "lending",
                        "primary_chain": "ethereum",
                        "headline_grade": "F",
                        "headline_badge": "CHRONIC",
                        "total_value_secured_usd": 14063906193,
                        "graded_at": "2026-04-27T02:35:53Z",
                        "rubric_version": "v1.5.0",
                        "status": "live",
                        "has_active_incident": true
                      },
                      "deployments": [],
                      "factor_scores": []
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/factors.json": {
      "get": {
        "operationId": "listFactors",
        "summary": "Factor encyclopedia",
        "description": "All 184 factors: id, category, name, description, is_critical, curation archetype.",
        "tags": [
          "factors"
        ],
        "responses": {
          "200": {
            "description": "Factor list envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://defirisk.co/api/v1.5.0/schema/envelope.json"
                },
                "example": {
                  "rubric_version": "v1.5.0",
                  "data_as_of": "2026-04-27T05:38:08Z",
                  "generated_at": "2026-04-27T05:38:10Z",
                  "data": {
                    "factors": [
                      {
                        "id": "RD-F-001",
                        "category_id": 1,
                        "name": "Audit scope mismatch",
                        "description": "Check whether the commit SHA cited in the audit report matches the bytecode deployed at the production proxy/implementation address.",
                        "is_critical": true,
                        "curation_archetype": "PH",
                        "introduced_in_rubric": "v1.5.0",
                        "deprecated_in_rubric": null
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/factors/{id}.json": {
      "get": {
        "operationId": "getFactor",
        "summary": "Factor detail",
        "description": "Full per-factor blob: methodology, scored_protocols (how every protocol in the coverage list scores on this factor), and linked_hacks.",
        "tags": [
          "factors"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^RD-F-\\d{3}$"
            },
            "description": "Factor ID, e.g. `RD-F-001`",
            "example": "RD-F-001"
          }
        ],
        "responses": {
          "200": {
            "description": "Factor detail envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://defirisk.co/api/v1.5.0/schema/envelope.json"
                },
                "example": {
                  "rubric_version": "v1.5.0",
                  "data_as_of": "2026-04-27T05:38:08Z",
                  "generated_at": "2026-04-27T05:38:10Z",
                  "data": {
                    "factor_data": {
                      "factor": {
                        "id": "RD-F-001",
                        "category_id": 1,
                        "name": "Audit scope mismatch",
                        "description": "Check whether the commit SHA cited in the audit report matches the bytecode deployed at the production proxy/implementation address.",
                        "is_critical": true,
                        "curation_archetype": "PH",
                        "introduced_in_rubric": "v1.5.0",
                        "deprecated_in_rubric": null
                      },
                      "scored_protocols": [],
                      "linked_hacks": []
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/hacks.json": {
      "get": {
        "operationId": "listHacks",
        "summary": "Hack ledger",
        "description": "All documented DeFi security incidents with root-cause analysis and linked risk factors.",
        "tags": [
          "hacks"
        ],
        "responses": {
          "200": {
            "description": "Hack list envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://defirisk.co/api/v1.5.0/schema/envelope.json"
                },
                "example": {
                  "rubric_version": "v1.5.0",
                  "data_as_of": "2026-04-27T05:38:08Z",
                  "generated_at": "2026-04-27T05:38:10Z",
                  "data": {
                    "hacks": [
                      {
                        "id": "kelp-dao-rekt",
                        "protocol_slug": null,
                        "protocol_name": "Kelp DAO (rsETH liquid restaking)",
                        "occurred_at": "2026-04-18",
                        "loss_usd": 292000000,
                        "category": "Liquid Restaking Token (LRT) / Cross-Chain Bridge",
                        "root_cause": "Forged cross-chain message via LayerZero EndpointV2 lzReceive — exploitation of 1/1 DVN (single-validator) configuration",
                        "description": "An attacker forged a single LayerZero message to drain $292M in rsETH from Kelp DAO's mainnet bridge reserve, then weaponized the unbacked tokens as Aave collateral to borrow $196M in ETH — all inside the 46-minute window before Kelp could pause.",
                        "postmortem_url": null,
                        "funds_recovered_pct": null,
                        "is_active": false,
                        "status": "closed",
                        "linked_factors": [
                          {
                            "factor_id": "RD-F-004",
                            "relevance": "causal",
                            "notes": "Audit count likely 0; floor display [via dashboard_risk_factors/Vulnerability in audited or unaudited code: Likely unaudited or out-of-scope code (bridge contracts excluded from bug bounty; audit coverage of lzReceive configuration unconfirmed)]"
                          },
                          {
                            "factor_id": "RD-F-006",
                            "relevance": "causal",
                            "notes": "Audit-deploy gap (RD-F-006 time between audit and deploy) [via dashboard_risk_factors/Exploited code newly deployed/upgraded?: N — the 1/1 DVN configuration had been in place at least since Jan 2025 (when flagged); this was a long-latent misconfiguration, not a new d...] || Audit-deploy gap — alternate field name [via dashboard_risk_factors/Exploited code newly deployed/upgraded?: N — the 1/1 DVN configuration had been in place at least since Jan 2025 (when flagged); this was a long-latent misconfiguration, not a new d...]"
                          },
                          {
                            "factor_id": "RD-F-090",
                            "relevance": "illustrative",
                            "notes": "Mixer withdrawal → protocol interaction [via realtime_signals/Pre-exploit on-chain signals: Six attacker wallets funded via Tornado Cash ~10 hours before exploit (07:35 UTC); no documented anomalous rsETH-bridge or OFTAdapter activi...]"
                          },
                          {
                            "factor_id": "RD-F-146",
                            "relevance": "related",
                            "notes": "New deploys in last 30 days — fresh attack surface [via dashboard_risk_factors/Exploited code newly deployed/upgraded?: N — the 1/1 DVN configuration had been in place at least since Jan 2025 (when flagged); this was a long-latent misconfiguration, not a new d...]"
                          },
                          {
                            "factor_id": "RD-F-148",
                            "relevance": "causal",
                            "notes": "Bridge validator count (M) — LayerZero DVN sub-field [via cross-hack: Factor 80: DVN / Multi-Validator Configuration on Cross-Chain Messages]"
                          },
                          {
                            "factor_id": "RD-F-149",
                            "relevance": "related",
                            "notes": "Bridge validator threshold (k-of-M) [via cross-hack: Factor 80: DVN / Multi-Validator Configuration on Cross-Chain Messages]"
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },

{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://defirisk.co/api/v1.5.0/schema/hack.json",
  "title": "Hack (security incident)",
  "description": "One entry in the hacks ledger. From hacks.json or hacks/<id>.json.",
  "type": "object",
  "required": ["id", "protocol_name", "root_cause"],
  "properties": {
    "id": { "type": "string", "description": "URL-safe identifier, e.g. kelp-dao-rekt" },
    "protocol_slug": { "type": ["string", "null"], "description": "Links to /protocols/<slug> when the protocol is in the coverage list." },
    "protocol_name": { "type": "string" },
    "occurred_at": { "type": ["string", "null"], "format": "date" },
    "loss_usd": { "type": ["number", "null"], "description": "Approximate USD value of funds lost at time of incident." },
    "category": { "type": ["string", "null"] },
    "root_cause": { "type": "string" },
    "description": { "type": ["string", "null"] },
    "postmortem_url": { "type": ["string", "null"], "format": "uri" },
    "funds_recovered_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "is_active": { "type": "boolean" },
    "status": { "type": "string", "enum": ["open", "closed", "under_review"] },
    "linked_factors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["factor_id", "relevance"],
        "properties": {
          "factor_id": { "type": "string" },
          "relevance": { "type": "string", "enum": ["causal", "contributing", "related", "illustrative"] },
          "notes": { "type": ["string", "null"] }
        }
      }
    }
  }
}

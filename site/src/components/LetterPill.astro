---
import type { Letter } from '../lib/rubric';

export type LetterPillSize = 'mini' | 'medium' | 'hero';

export interface Props {
  letter: Letter;
  size?: LetterPillSize;
  meaning?: string;
  /** Numeric risk score rendered as a string (e.g. "14.3"), displayed in hero size only. */
  score?: string;
  /** Reserve a hidden score node so a hydrated family view can populate it. */
  reserveScore?: boolean;
  ariaLabel?: string;
}

const { letter, size = 'medium', meaning, score, reserveScore = false, ariaLabel } = Astro.props;

const ariaLabelResolved = ariaLabel ?? `Grade ${letter}`;
---

{
  size === 'mini' && (
    <span class:list={['gpill', letter]} aria-label={ariaLabelResolved}>
      {letter}
    </span>
  )
}
{
  size === 'medium' && (
    <span class:list={['gpill-lg', letter]} aria-label={ariaLabelResolved}>
      {letter}
    </span>
  )
}
{
  size === 'hero' && (
    <div class:list={['gradebig', letter]} role="img" aria-label={ariaLabelResolved}>
      {meaning && <span class="m">{meaning}</span>}
      <span class="l">{letter}</span>
      {reserveScore ? (
        <span class="n" hidden={score === undefined}>
          {score ?? ''}
        </span>
      ) : (
        score && <span class="n">{score}</span>
      )}
    </div>
  )
}

<style>
  /* Mini: 18×18, used in filter chips next to "Grade A" labels */
  .gpill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 10.5px;
    color: var(--grade-on-fill);
  }
  .gpill.A {
    background: var(--gA-fill);
  }
  .gpill.B {
    background: var(--gB-fill);
  }
  .gpill.C {
    background: var(--gC-fill);
  }
  .gpill.D {
    background: var(--gD-fill);
  }
  .gpill.F {
    background: var(--gF-fill);
  }

  /* Medium: 34×34, used in protocol row Grade column */
  .gpill-lg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 5px;
    font-weight: 700;
    font-size: 15px;
    color: var(--grade-on-fill);
    letter-spacing: 0;
    font-feature-settings: 'lnum';
  }
  .gpill-lg.A {
    background: var(--gA-fill);
  }
  .gpill-lg.B {
    background: var(--gB-fill);
  }
  .gpill-lg.C {
    background: var(--gC-fill);
  }
  .gpill-lg.D {
    background: var(--gD-fill);
  }
  .gpill-lg.F {
    background: var(--gF-fill);
  }

  /* Hero: 256×256 (or container-sized), used in protocol detail rail */
  .gradebig {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--grade-on-fill);
    position: relative;
    box-shadow: inset 0 -3px 0 rgba(0, 0, 0, 0.1);
  }
  .gradebig.A {
    background: var(--gA-fill);
  }
  .gradebig.B {
    background: var(--gB-fill);
  }
  .gradebig.C {
    background: var(--gC-fill);
  }
  .gradebig.D {
    background: var(--gD-fill);
  }
  .gradebig.F {
    background: var(--gF-fill);
  }
  .gradebig .l {
    font-size: 130px;
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    font-feature-settings: 'lnum';
  }
  .gradebig .n {
    position: absolute;
    bottom: 14px;
    right: 18px;
    font-family: 'Geist Mono', monospace;
    font-size: 14px;
    font-weight: 600;
    font-feature-settings: 'tnum';
    letter-spacing: -0.01em;
    opacity: 1;
  }
  .gradebig .n[hidden] {
    display: none;
  }
  .gradebig .m {
    position: absolute;
    top: 14px;
    left: 18px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 1;
  }
</style>

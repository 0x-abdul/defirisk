---
export interface Props {
  title?: string;
  lang?: string;
  code: string;
  copyLabel: string;
}

const { title, lang, code, copyLabel } = Astro.props;
const hasBar = Boolean(title || lang);
---

<div class="codeblock">
  {
    hasBar && (
      <div class="cbar">
        <div class="ctitle">
          <span class="dot" aria-hidden="true" />
          {title && <span>{title}</span>}
          {lang && <span class="lang">{lang}</span>}
        </div>
        <button type="button" class="copy" aria-label={copyLabel}>
          Copy
        </button>
        <span class="copy-status" role="status" aria-live="polite" aria-atomic="true"></span>
      </div>
    )
  }
  <pre>{code}</pre>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('.codeblock button.copy').forEach(function (btn) {
      if (btn.dataset.copyBound === 'true') return;
      btn.dataset.copyBound = 'true';
      btn.addEventListener('click', function () {
        var block = btn.closest('.codeblock');
        var pre = block && block.querySelector('pre');
        var status = block && block.querySelector('.copy-status');
        if (!pre) return;
        if (!navigator.clipboard || !navigator.clipboard.writeText) return;
        Promise.resolve(navigator.clipboard.writeText(pre.textContent || ''))
          .then(function () {
            var original = btn.textContent;
            btn.classList.add('ok');
            btn.textContent = 'Copied';
            if (status) status.textContent = 'Copied';
            setTimeout(function () {
              btn.classList.remove('ok');
              btn.textContent = original;
              if (status) status.textContent = '';
            }, 1200);
          })
          .catch(function () {
            /* Leave the control unchanged when clipboard access is unavailable. */
          });
      });
    });
  })();
</script>

<style>
  .codeblock {
    margin: 18px 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .codeblock .cbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    font-family: 'Geist Mono', monospace;
    font-size: 11px;
    color: var(--fg-3);
  }
  .codeblock .cbar .ctitle {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .codeblock .cbar .ctitle .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fg-4);
  }
  .codeblock .cbar .ctitle .lang {
    color: var(--fg-2);
    font-weight: 500;
  }
  .codeblock .cbar .copy {
    font: inherit;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--fg-2);
    padding: 3px 9px;
    border-radius: 5px;
    cursor: pointer;
    font-size: 10.5px;
    letter-spacing: 0.02em;
  }
  .codeblock .cbar .copy:hover {
    background: var(--surface-2);
    color: var(--fg);
  }
  .codeblock .cbar .copy.ok {
    color: var(--gA);
    border-color: var(--gA);
  }
  .codeblock .cbar .copy-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .codeblock pre {
    margin: 0;
    padding: 14px 16px;
    font-family: 'Geist Mono', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 13px;
    line-height: 1.6;
    color: var(--fg);
    overflow-x: auto;
    font-feature-settings: 'tnum';
    max-width: 100%;
    word-break: break-word;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }
  .codeblock pre :global(.c-key) {
    color: var(--fg);
  }
  .codeblock pre :global(.c-str) {
    color: var(--gA);
  }
  .codeblock pre :global(.c-num) {
    color: var(--gD);
  }
  .codeblock pre :global(.c-com) {
    color: var(--fg-3);
    font-style: italic;
  }
  .codeblock pre :global(.c-cmd) {
    color: var(--fg-2);
  }
  .codeblock pre :global(.c-flag) {
    color: var(--gC);
  }
  .codeblock pre :global(.c-url) {
    color: var(--fg);
  }
</style>

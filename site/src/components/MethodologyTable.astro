---
import type { Letter } from '../lib/rubric';

export interface MethodologyRow {
  letter: Letter;
  meaning: string;
  evidence: string;
  critical: string;
}

export interface Props {
  rows?: MethodologyRow[];
}

const DEFAULT_ROWS: MethodologyRow[] = [
  {
    letter: 'A',
    meaning: 'Resilient',
    evidence: 'Risk score ≤ 12, no critical reds, and no core-five cap.',
    critical: '0',
  },
  {
    letter: 'B',
    meaning: 'Sound',
    evidence: 'Risk score > 12 and ≤ 20 with 0 critical reds, or exactly 1 critical red with score ≤ 20. One critical red blocks A and adds 5 risk points.',
    critical: '0 or 1',
  },
  {
    letter: 'C',
    meaning: 'Watch',
    evidence: 'Risk score > 20 and ≤ 35. One critical red may still land here depending on the score.',
    critical: '0 or 1',
  },
  {
    letter: 'D',
    meaning: 'Compromised',
    evidence: 'Risk score > 35 and ≤ 55, two or more critical reds, or core-five severity ≥ 60.',
    critical: '2+',
  },
  {
    letter: 'F',
    meaning: 'Failing',
    evidence: 'Risk score > 55, three or more critical reds, or core-five severity ≥ 90.',
    critical: '3+',
  },
];

const { rows = DEFAULT_ROWS } = Astro.props;
---

<div class="ttable" tabindex="0" role="region" aria-label="Methodology table">
  <table>
    <thead>
      <tr>
        <th style="width:60px">Grade</th>
        <th style="width:110px">Meaning</th>
        <th>Required evidence</th>
        <th style="width:130px">Critical factors</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <td>
              <span class="gcell">
                <span class:list={['gpill', r.letter]}>{r.letter}</span>
              </span>
            </td>
            <td>
              <b>{r.meaning}</b>
            </td>
            <td>{r.evidence}</td>
            <td class="mono">{r.critical}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

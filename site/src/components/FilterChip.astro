---
export type ChipSeverity = 'r' | 'y' | 'g';

export interface Props {
  label: string;
  count?: number;
  severity?: ChipSeverity[];
  on?: boolean;
  href?: string;
  title?: string;
}

const { label, count, severity, on = false, href, title } = Astro.props;
const isSeverity = Array.isArray(severity) && severity.length > 0;
const Tag = href ? 'a' : 'button';
---

<Tag
  type={href ? undefined : 'button'}
  href={href}
  class:list={['chip', { on, severity: isSeverity }]}
  title={title}
  aria-pressed={href ? undefined : on ? 'true' : 'false'}
>
  <slot name="prefix" />
  <span class="label">{label}</span>
  {count !== undefined && count > 0 && <span class="ct">{count}</span>}
  {isSeverity && severity!.map((s) => <span class:list={['sev', s]} aria-hidden="true" />)}
</Tag>

<style>
  .chip {
    padding: 4px 10px;
    border-radius: 14px;
    font-size: 11.5px;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--fg-2);
    cursor: pointer;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    line-height: 1.3;
    text-decoration: none;
    font-family: inherit;
  }
  .chip:hover {
    border-color: var(--border-2);
    color: var(--fg);
  }
  .chip.on {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .chip .ct {
    font-family: 'Geist Mono', monospace;
    font-size: 10px;
  }
  .chip.severity {
    padding: 4px 8px;
  }
  .chip.severity .sev {
    display: inline-flex;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .chip.severity .sev.r {
    background: var(--gF);
  }
  .chip.severity .sev.y {
    background: var(--gC);
  }
  .chip.severity .sev.g {
    background: var(--gA);
  }
</style>

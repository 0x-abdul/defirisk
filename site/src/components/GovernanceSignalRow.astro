---
export type SignalLight = 'red' | 'yellow' | 'green' | 'gray';

export interface Props {
  label: string;
  light: SignalLight;
  value: string;
  /** Right-side small caption below the value. */
  sub?: string;
  /** Render sub in red (var(--gF)) to flag a problematic value. */
  subBad?: boolean;
  /** Optional split marker rendered between numerator and denominator in value (e.g. "5 / 11"). */
  valuePrefix?: string;
  valueSlash?: string;
  valueSuffix?: string;
}

const { label, light, value, sub, subBad = false, valuePrefix, valueSlash, valueSuffix } = Astro.props;
---

<div class="mi ctrl">
  <span class="left">
    <span class:list={['dot', light]} aria-hidden="true"></span>
    {label}
  </span>
  <span class="right">
    <span class="v">
      {valuePrefix && <Fragment>{valuePrefix}</Fragment>}
      {valueSlash && <span class="sl">{valueSlash}</span>}
      {valueSuffix && <Fragment>{valueSuffix}</Fragment>}
      {!valuePrefix && !valueSlash && !valueSuffix && value}
    </span>
    {sub && <span class:list={['sub', subBad && 'bad']}>{sub}</span>}
  </span>
</div>

<style>
  .mi {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 7px 0;
    font-size: 11.5px;
    color: var(--fg-3);
    border-bottom: 1px solid var(--border);
  }
  .mi:last-child {
    border-bottom: none;
  }
  .mi.ctrl {
    align-items: center;
    padding: 9px 0;
  }
  .mi.ctrl .left {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .mi.ctrl .left .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .mi.ctrl .left .dot.red {
    background: var(--gF);
  }
  .mi.ctrl .left .dot.yellow {
    background: var(--gC);
  }
  .mi.ctrl .left .dot.green {
    background: var(--gA);
  }
  .mi.ctrl .left .dot.gray {
    background: var(--fg-4);
  }
  .mi.ctrl .right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    text-align: right;
  }
  .mi.ctrl .right .v {
    color: var(--fg);
    font-weight: 600;
    font-size: 12.5px;
    font-feature-settings: 'tnum';
    font-family: 'Geist Mono', monospace;
    letter-spacing: -0.01em;
  }
  .mi.ctrl .right .v .sl {
    color: var(--fg-3);
    font-weight: 400;
  }
  .mi.ctrl .right .sub {
    color: var(--fg-3);
    font-size: 10px;
    font-family: 'Geist Mono', monospace;
    letter-spacing: 0.01em;
  }
  .mi.ctrl .right .sub.bad {
    color: var(--gF-text);
  }
</style>

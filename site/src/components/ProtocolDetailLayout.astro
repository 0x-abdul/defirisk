---
/**
 * ProtocolDetailLayout shared body for the protocol detail page.
 *
 * Rendered by two routes:
 *   - /protocols/<slug>/                    (published; canonical public URL)
 *   - /unpublished/<slug>-<token>/          (pre-publication review; noindex)
 *
 * The two routes diverge only in:
 *   - the JSON loader they use (getProtocol vs getProtocolByReviewPath)
 *   - whether `reviewMode` is true (adds the "Pending review" banner; the
 *     /unpublished/ route also passes noindex to <Base>)
 *
 * Everything below this comment is identical for both; keeping the body
 * in a single component prevents drift between published and review
 * renders of the same protocol.
 */
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import BigGradeCard from '../components/BigGradeCard.astro';
import VerdictBlock from '../components/VerdictBlock.astro';
import GovernanceSignalRow from '../components/GovernanceSignalRow.astro';
import IncidentBanner from '../components/IncidentBanner.astro';
import FactorAssessment from '../components/FactorAssessment';
import DeploymentTabs from '../components/DeploymentTabs';
import ProtocolSurfaceExplorer from '../components/ProtocolSurfaceExplorer';
import { listFactors, listIncidents, type ProtocolDetail } from '../lib/data-loaders';
import { buildFactorAssessmentModel } from '../lib/factor-assessment-model';
import {
  buildAssessmentHeaderModel,
  finiteNumber,
  formatAssessmentDateUtc,
  GRADE_MEANING,
} from '../lib/assessment-header-model';
import { selectDefaultSurface } from '../lib/family-view-url';
import { loadCuratorSidecar } from '../lib/curator-sidecar';
import { RUBRIC_VERSION } from '../lib/rubric';
import { REPO_URL, ISSUE_NEW_URL } from '../lib/seo-defaults';
import type { Letter } from '../lib/rubric';
import { TOTAL_FACTOR_COUNT } from '../lib/rubric-constants';
import { CATEGORIES, chainMeta } from '../data/categories';

export interface Props {
  detail: ProtocolDetail;
  reviewMode?: boolean;
  /** Optional explicit canonical override (used by the /unpublished/ route
   *  to keep the review URL out of canonical link metadata). */
  canonical?: string;
}

const { detail, reviewMode = false, canonical } = Astro.props;

const proto = detail.protocol as Record<string, unknown>;
const surfaces = (detail.surfaces as Array<Record<string, unknown>> | undefined) ?? [];
const multiSurface = surfaces.length > 1;
const defaultSurface = multiSurface ? selectDefaultSurface(surfaces) : null;
const assessment = defaultSurface ?? proto;
const slug = (proto.slug as string) ?? '';
const headlineGrade = (assessment.headline_grade ?? null) as Letter | null;
const displayName = (proto.display_name as string) ?? slug;
const protocolType = (proto.protocol_type as string) ?? 'N/A';
const primaryChain = (proto.primary_chain as string) ?? 'N/A';
const description = (proto.description as string) ?? '';
const gradedAt = (assessment.graded_at as string | null) ?? null;
const tvlUsd = ((): number => {
  const v = proto.total_value_secured_usd;
  if (typeof v === 'number') return v;
  if (typeof v === 'string') return parseFloat(v) || 0;
  return 0;
})();
const categoryLights =
  (assessment.category_lights as Record<number, 'red' | 'yellow' | 'green' | 'gray'>) ?? {};

// M1 v4 fields
const riskScore = finiteNumber(assessment.risk_score);
const categorySeverities =
  (assessment.category_severities as Record<string, number> | null | undefined) ?? null;
const capApplied = (assessment.cap_applied as 'none' | 'D' | 'F' | null | undefined) ?? 'none';
const capReason = (assessment.cap_reason as string | null | undefined) ?? null;

// Deployments
const deploymentsRaw = (detail.deployments as Array<Record<string, unknown>>) ?? [];
const deployments = deploymentsRaw.map((d) => {
  const chainId = (d.chain as string) ?? '';
  const m = chainMeta(chainId);
  return {
    chain_id: chainId,
    chain_name: m.name,
    color: m.color ?? '#7a7e85',
    mark: m.mark ?? chainId.charAt(0).toUpperCase(),
    tvs_usd: ((): number => {
      const v = d.tvs_usd;
      if (typeof v === 'number') return v;
      if (typeof v === 'string') return parseFloat(v) || 0;
      return 0;
    })(),
  };
});

// Factor scores → group by category_id
const factors = listFactors();
const factorMeta = factors.map((factor) => ({
  id: factor.id,
  name: factor.name,
  category_id: factor.category_id,
  is_critical: factor.is_critical,
}));
const factorScoresRaw =
  ((multiSurface ? assessment.factor_scores : detail.factor_scores) as Array<{
    factor_id?: string;
    score?: 'red' | 'yellow' | 'green' | 'gray' | 'not_assessed' | 'not_applicable';
    evidence_summary?: string;
    gap_reason?: string | null;
  }>) ?? [];
const factorAssessment = buildFactorAssessmentModel({
  context: {
    protocolSlug: slug,
    surfaceSlug: multiSurface
      ? ((defaultSurface?.surface_slug as string | undefined) ?? null)
      : null,
  },
  categories: CATEGORIES,
  factors: factorMeta,
  scores: factorScoresRaw,
  categoryLights,
  categorySeverities,
  reviewMode,
});
const totals = {
  r: factorAssessment.totals.red,
  y: factorAssessment.totals.yellow,
  g: factorAssessment.totals.green,
};
const criticalRed = factorAssessment.criticalRed;
const initialHeader = buildAssessmentHeaderModel({
  mode: 'default',
  headlineGrade,
  riskScore,
  gradedAt,
  status: (assessment.status as string | null | undefined) ?? null,
  scopeNote: (assessment.scope_note as string | null | undefined) ?? null,
  capApplied,
  capReason,
  factorAssessment,
});
const CRITICAL_IDS = new Set(
  factors.filter((factor) => factor.is_critical).map((factor) => factor.id)
);

// Active incidents only render on the published view; unpublished review
// pages are pre-launch and should not surface incident banners from the
// public ledger (the protocol isn't on the public dashboard yet).
const incidents = reviewMode ? [] : listIncidents();
const activeIncident = incidents.find((i) => i.protocol_slug === slug && i.status === 'open');

// Curator sidecar: verdict body + multisig/timelock cells when upstream pipeline
// doesn't yet emit them. Null for most protocols pending curator pass.
const curator = loadCuratorSidecar(slug);
const multisigCell = curator?.multisig ?? null;
const timelockCell = curator?.timelock ?? null;

function fmtTvl(usd: number): string {
  if (!Number.isFinite(usd) || usd <= 0) return 'N/A';
  if (usd >= 1e9) return `$${(usd / 1e9).toFixed(1)}B`;
  if (usd >= 1e6) return `$${(usd / 1e6).toFixed(1)}M`;
  if (usd >= 1e3) return `$${(usd / 1e3).toFixed(0)}K`;
  return `$${usd.toFixed(0)}`;
}

const lastAssessedDisplay = multiSurface
  ? initialHeader.reviewed
  : gradedAt
    ? formatAssessmentDateUtc(gradedAt)
    : 'N/A';

// JSON-envelope link target. For published pages the file lives at
// /api/<rubric>/protocols/<slug>.json. For review pages the JSON sits
// under /api/<rubric>/unpublished/<slug>-<token>/index.json, but we
// derive the path off the route slug because the layout doesn't know the
// review token, so on the review page we hide the JSON link instead
// of pointing it at a stale published path.
const envelopeHref = reviewMode ? null : `/api/${RUBRIC_VERSION}/protocols/${slug}.json`;

// Corrections & disputes links (see /corrections). The factual-correction and
// grade-dispute templates are the two channels a protocol team uses; the
// per-slug issue search is the public audit trail for this protocol.
const correctionHref = `${ISSUE_NEW_URL}?template=factual-correction.md`;
const disputeHref = `${ISSUE_NEW_URL}?template=grade-dispute.md`;
const protocolIssuesHref = `${REPO_URL}/issues?q=${encodeURIComponent(`is:issue ${slug}`)}`;
const legacyCaveat =
  ((detail.family as Record<string, unknown> | undefined)?.legacy_caveat as
    string | null | undefined) ??
  (proto.legacy_caveat as string | null | undefined) ??
  null;
---

<Base
  title={displayName}
  description={description || `Risk assessment for ${displayName}`}
  noindex={reviewMode}
  canonical={canonical}
>
  <TopBar slot="topbar" />
  <Fragment slot="banner">
    {
      reviewMode && (
        <div class="review-banner" role="status">
          <span class="review-icon" aria-hidden="true">
            🔍
          </span>
          <div class="review-text">
            <p class="review-lead">
              <b>This assessment is unpublished</b> — you are viewing a private review link.
            </p>
            <ul class="review-actions">
              <li>
                A number, link, or config is <b>wrong</b>?
                <a href={correctionHref}>File a factual correction</a> with a source.
              </li>
              <li>
                The facts are right but you think the <b>rubric was misapplied</b>?
                <a href={disputeHref}>File a grade dispute</a>.
              </li>
            </ul>
            <p class="review-note">
              We correct the underlying <b>factor</b>, never the letter directly. The grade
              recomputes from the corrected evidence. You can also reply on the channel this link
              came from. Full process:
              <a href="/contributions/#corrections">Corrections &amp; disputes</a>.
            </p>
          </div>
        </div>
      )
    }
    {
      activeIncident && (
        <IncidentBanner
          variant={activeIncident.severity}
          headline={activeIncident.headline}
          dismissKey={`incident-${activeIncident.id}`}
        />
      )
    }
  </Fragment>

  <Breadcrumb
    items={[
      { n: 'Protocols', href: '/' },
      { n: protocolType.charAt(0).toUpperCase() + protocolType.slice(1) },
      { n: displayName },
    ]}
  />

  {
    multiSurface ? (
      <div
        data-family-cap
        class:list={['cap-banner', initialHeader.capApplied === 'F' ? 'cap-f' : 'cap-d']}
        hidden={initialHeader.capApplied === 'none' || !initialHeader.capReason}
      >
        <span class="cap-icon" aria-hidden="true">
          {initialHeader.capApplied === 'F' ? '⚠' : '▲'}
        </span>
        <span class="cap-text">
          <b data-family-cap-title>Grade capped to {initialHeader.capApplied}</b>:
          <span data-family-cap-reason> {initialHeader.capReason}</span>
        </span>
      </div>
    ) : (
      capApplied !== 'none' &&
      capReason && (
        <div class:list={['cap-banner', capApplied === 'F' ? 'cap-f' : 'cap-d']}>
          <span class="cap-icon" aria-hidden="true">
            {capApplied === 'F' ? '⚠' : '▲'}
          </span>
          <span class="cap-text">
            <b>Grade capped to {capApplied}</b>: {capReason}
          </span>
        </div>
      )
    )
  }

  <div class="layout">
    <aside class="rail">
      <div class="gradeblock">
        {
          multiSurface ? (
            <>
              <div data-family-grade-scored hidden={!initialHeader.grade}>
                <BigGradeCard
                  letter={initialHeader.grade ?? 'A'}
                  meaning={GRADE_MEANING[initialHeader.grade ?? 'A']}
                  score={initialHeader.riskScore ?? undefined}
                  reserveScore
                />
              </div>
              <div
                data-family-grade-empty
                class="gradebig-unscored"
                aria-label="Not yet scored"
                hidden={Boolean(initialHeader.grade)}
              >
                <span class="l">N/A</span>
                <span class="m">Pending</span>
              </div>
            </>
          ) : headlineGrade ? (
            <BigGradeCard
              letter={headlineGrade}
              meaning={GRADE_MEANING[headlineGrade]}
              score={riskScore ?? undefined}
            />
          ) : (
            <div class="gradebig-unscored" aria-label="Not yet scored">
              <span class="l">N/A</span>
              <span class="m">Pending</span>
            </div>
          )
        }
        {
          multiSurface ? (
            <div data-family-verdict hidden={!initialHeader.grade}>
              <VerdictBlock letter={initialHeader.grade ?? 'A'} />
            </div>
          ) : (
            headlineGrade && (
              <VerdictBlock letter={headlineGrade} body={curator?.verdict_body ?? undefined} />
            )
          )
        }
      </div>

      <div class="pname">{displayName}</div>
      <div class="ptag">
        {protocolType} · {chainMeta(primaryChain).name}
      </div>

      <div class="meta">
        <div class="mi">
          <span>{multiSurface ? 'Family TVL' : 'TVL'}</span>
          <b>{fmtTvl(tvlUsd)}</b>
        </div>
        <div class="mi">
          <span>Sector</span>
          <b>{protocolType}</b>
        </div>
        <div class="mi">
          <span>Last assessed</span>
          <b data-family-field={multiSurface ? 'reviewed' : undefined}>{lastAssessedDisplay}</b>
        </div>
        <div class="mi">
          <span>Critical findings</span>
          <b
            data-family-field={multiSurface ? 'critical' : undefined}
            style={criticalRed > 0 ? 'color: var(--gF)' : ''}
          >
            {criticalRed} of {CRITICAL_IDS.size}
          </b>
        </div>
        {
          (riskScore !== null || multiSurface) && (
            <div
              class="mi"
              data-family-field={multiSurface ? 'risk-row' : undefined}
              hidden={multiSurface && riskScore === null}
            >
              <span>Risk score</span>
              <b class="mono">
                <span data-family-field={multiSurface ? 'risk' : undefined}>
                  {riskScore?.toFixed(1)}
                </span>
                <span class="mi-unit"> / 100</span>
              </b>
            </div>
          )
        }
        <div class="mi">
          <span>Severity (R / Y / G)</span>
          <b class="mono" data-family-field={multiSurface ? 'severity' : undefined}>
            {totals.r} · {totals.y} · {totals.g}
          </b>
        </div>
        <GovernanceSignalRow
          label="Multisig"
          light={multisigCell?.light ?? 'gray'}
          value={multisigCell?.value ?? 'N/A'}
          sub={multisigCell?.sub ?? 'curator pending'}
        />
        <GovernanceSignalRow
          label="Timelock"
          light={timelockCell?.light ?? 'gray'}
          value={timelockCell?.value ?? 'N/A'}
          sub={timelockCell?.sub ?? 'curator pending'}
        />
      </div>

      {
        !multiSurface && (
          <>
            <h5>Categories</h5>
            <nav class="toc" aria-label="Category jump links">
              {CATEGORIES.map((c) => {
                const cl = categoryLights[c.id] ?? 'gray';
                const category = factorAssessment.categories.find((entry) => entry.id === c.id);
                const issues =
                  category?.rows.filter((row) => row.light === 'red' || row.light === 'yellow')
                    .length ?? 0;
                return (
                  <a href={`#cat-${c.id}`}>
                    <span class="lbl">
                      <span class:list={['dot', cl]} aria-hidden="true" />
                      <span>{c.short ?? c.name}</span>
                    </span>
                    <span class="ct">{issues > 0 ? `${issues}` : 'N/A'}</span>
                  </a>
                );
              })}
            </nav>
          </>
        )
      }

      <div class="actions">
        {
          envelopeHref && (
            <a href={envelopeHref}>
              JSON envelope <span class="arr">↗</span>
            </a>
          )
        }
        {
          !reviewMode && (
            <a href={`/factors/?protocol=${slug}`}>
              All factors <span class="arr">→</span>
            </a>
          )
        }
      </div>
    </aside>

    <div class="body">
      <div class="masthead">
        <h1>{displayName}</h1>
        {description && <p class="sub">{description}</p>}
        <div class="body-meta">
          <div class="mi">
            <span>Sector</span>
            <b>{protocolType}</b>
          </div>
          <div class="mi">
            <span>{multiSurface ? 'Family TVL' : 'TVL'}</span>
            <b>{fmtTvl(tvlUsd)}</b>
          </div>
          <div class="mi">
            <span>Reviewed</span>
            <b data-family-field={multiSurface ? 'body-reviewed' : undefined}>
              {lastAssessedDisplay}
            </b>
          </div>
          <div class="mi">
            <span>Factors</span>
            <b>{TOTAL_FACTOR_COUNT}</b>
          </div>
          <div class="mi">
            <span>Categories</span>
            <b>{CATEGORIES.length}</b>
          </div>
          {
            (riskScore !== null || multiSurface) && (
              <div
                class="mi"
                data-family-field={multiSurface ? 'body-risk-row' : undefined}
                hidden={multiSurface && riskScore === null}
              >
                <span>Risk score</span>
                <b data-family-field={multiSurface ? 'body-risk' : undefined}>
                  {riskScore?.toFixed(1)}
                </b>
              </div>
            )
          }
        </div>
      </div>

      {
        multiSurface ? (
          <ProtocolSurfaceExplorer
            client:load
            familySlug={slug}
            surfaces={surfaces}
            categories={CATEGORIES}
            factors={factorMeta}
            reviewMode={reviewMode}
            legacyCaveat={legacyCaveat}
          />
        ) : (
          <>
            {deployments.length > 0 && <DeploymentTabs client:visible deployments={deployments} />}

            <FactorAssessment model={factorAssessment} />
          </>
        )
      }

      <div class="envelope">
        <span><b>rubric_version</b> {RUBRIC_VERSION}</span>
        {
          multiSurface ? (
            <span>
              <b>graded_at</b>{' '}
              <span data-family-field="provenance-date">
                {gradedAt?.slice(0, 19).replace('T', ' ') ?? 'N/A'}
              </span>
            </span>
          ) : (
            <span>
              <b>graded_at</b> {gradedAt?.slice(0, 19).replace('T', ' ') ?? 'N/A'}
            </span>
          )
        }
        <span><b>factors</b> {TOTAL_FACTOR_COUNT}</span>
        <span><b>protocol</b> {slug}</span>
      </div>

      {
        !reviewMode && (
          <p class="corrections-line">
            Spot an error? <a href={correctionHref}>Correct a fact</a> or
            <a href={disputeHref}> dispute the grade</a>. Every change is public.
            <a href={protocolIssuesHref}> Corrections &amp; disputes for {displayName} →</a>
          </p>
        )
      }
    </div>
  </div>
</Base>

<style>
  /* ─── Review banner (unpublished protocol preview) ─── */
  .review-banner {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 18px;
    font-size: 12.5px;
    line-height: 1.45;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, #a78bfa 8%, var(--bg));
    border-top: 2px solid #a78bfa;
  }
  .review-banner .review-icon {
    flex-shrink: 0;
    font-size: 14px;
    line-height: 1.45;
  }
  .review-banner .review-text {
    color: var(--fg-2);
  }
  .review-banner .review-text b {
    color: var(--fg);
    font-weight: 600;
  }
  .review-banner .review-text p {
    margin: 0;
  }
  .review-banner .review-lead {
    max-width: 78ch;
  }
  .review-banner .review-actions {
    margin: 7px 0 0;
    padding-left: 18px;
    max-width: 78ch;
  }
  .review-banner .review-actions li {
    margin: 2px 0;
  }
  .review-banner .review-note {
    margin-top: 7px;
    color: var(--fg-3);
    max-width: 78ch;
  }
  .review-banner .review-text a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--border-2);
    text-underline-offset: 2px;
    font-weight: 500;
  }
  .review-banner .review-text a:hover {
    text-decoration-color: var(--fg);
  }

  /* ─── Cap banner (M1 v4 single-category override) ─── */
  .cap-banner {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 18px;
    font-size: 12.5px;
    line-height: 1.45;
    border-bottom: 1px solid var(--border);
  }
  .cap-banner.cap-f {
    background: color-mix(in srgb, var(--gF) 8%, var(--bg));
    border-top: 2px solid var(--gF);
    color: var(--gF);
  }
  .cap-banner.cap-d {
    background: color-mix(in srgb, var(--gD) 8%, var(--bg));
    border-top: 2px solid var(--gD);
    color: var(--gD);
  }
  .cap-banner .cap-icon {
    flex-shrink: 0;
    font-size: 14px;
    line-height: 1.45;
  }
  .cap-banner .cap-text {
    color: var(--fg-2);
  }
  .cap-banner .cap-text b {
    color: var(--fg);
    font-weight: 600;
  }
  /* Muted unit suffix on risk score meta value */
  .mi-unit {
    font-size: 0.85em;
    color: var(--fg-2);
    font-weight: 400;
  }

  /* ─── DA1 layout (300px sticky rail + body) ─── */
  .layout {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    align-items: flex-start;
  }
  .rail {
    border-right: 1px solid var(--border);
    padding: 24px 22px;
    background: var(--surface);
    position: sticky;
    top: 52px;
    align-self: flex-start;
    max-height: calc(100vh - 52px);
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .rail::-webkit-scrollbar {
    width: 4px;
  }
  .rail::-webkit-scrollbar-thumb {
    background: var(--border-2);
    border-radius: 2px;
  }
  .gradeblock {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  [data-family-grade-scored],
  [data-family-verdict] {
    width: 100%;
  }
  [data-family-grade-scored][hidden],
  [data-family-grade-empty][hidden],
  [data-family-verdict][hidden],
  [data-family-cap][hidden],
  [data-family-field][hidden] {
    display: none !important;
  }
  .gradebig-unscored {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 14px;
    background: var(--surface-2);
    border: 1px dashed var(--border-2);
    color: var(--fg-3);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  .gradebig-unscored .l {
    font-size: 96px;
    font-weight: 700;
    color: var(--fg-4);
  }
  .gradebig-unscored .m {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .pname {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin-top: 18px;
    color: var(--fg);
  }
  .ptag {
    font-family: 'Geist Mono', monospace;
    font-size: 11px;
    color: var(--fg-3);
    margin-top: 4px;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 18px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }
  .meta .mi {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 7px 0;
    font-size: 11.5px;
    color: var(--fg-3);
    border-bottom: 1px solid var(--border);
  }
  .meta .mi:last-child {
    border-bottom: none;
  }
  .meta .mi b {
    color: var(--fg);
    font-weight: 600;
    font-feature-settings: 'tnum';
    font-size: 12.5px;
  }
  .meta .mi b.mono {
    font-family: 'Geist Mono', monospace;
  }

  .rail h5 {
    margin: 22px 0 9px;
    font-size: 10px;
    color: var(--fg-3);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .toc {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .toc a {
    display: flex;
    justify-content: space-between;

---
/**
 * Pre-publication review route.
 *
 * URL shape: /unpublished/<slug>-<token>/
 *   - <slug> is the canonical protocol slug (e.g. aave-v3).
 *   - <token> is an 8-hex-char value from protocols.review_token, generated
 *     by db/migrations/0007_review_token.sql. The token makes the URL
 *     unguessable (~4.3B possibilities).
 *
 * This route exists ONLY for the curator-controlled pre-launch review
 * window: a protocol team is sent the link, has ~1 week to flag errors,
 * then is_published is flipped via scripts/set_published.py and the
 * protocol moves to /protocols/<slug>/ at the next dump.py run.
 *
 * Discovery hardening:
 *   - <Base noindex /> emits <meta name="robots" content="noindex,nofollow">
 *   - site/public/robots.txt disallows /unpublished/
 *   - astro.config.mjs sitemap filter excludes /unpublished/
 *   - site/public/_headers adds X-Robots-Tag: noindex, nofollow
 *   - listProtocols() / index.json / sitemap / RSS never reference these
 *     protocols
 *
 * Data path: data/api/<rubric>/unpublished/<slug>-<token>/index.json, kept
 * separate from data/api/<rubric>/protocols/<slug>.json so the public JSON
 * tree never contains unpublished protocol files.
 */
import ProtocolDetailLayout from '../../components/ProtocolDetailLayout.astro';
import {
  listUnpublishedReviewEntries,
  getProtocolByReviewPath,
} from '../../lib/data-loaders';

export async function getStaticPaths() {
  return listUnpublishedReviewEntries().map((review) => ({ params: { review } }));
}

const { review } = Astro.params as { review: string };
const detail = getProtocolByReviewPath(review);

if (!detail) {
  return Astro.redirect('/404');
}
---

<ProtocolDetailLayout detail={detail} reviewMode />
{/* No canonical passed: reviewMode propagates noindex=true to Base, which now
    suppresses <link rel="canonical"> + og:url entirely. The prior
    canonical={Astro.url.toString()} leaked the secret review URL into
    canonical metadata; see p0-response 2026-05-30 (P0 #4). */}

---
import ProtocolDetailLayout from '../../../components/ProtocolDetailLayout.astro';
import { listPublishedProtocolSlugs, getProtocol } from '../../../lib/data-loaders';

export async function getStaticPaths() {
  // Published protocols only - unpublished ones render at /unpublished/<slug>-<token>/.
  return listPublishedProtocolSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params as { slug: string };
const detail = getProtocol(slug);

if (!detail) {
  return Astro.redirect('/404');
}

const proto = detail.protocol as Record<string, unknown>;
const canonicalFamily = proto.canonical_family_slug as string | undefined;
if (canonicalFamily && canonicalFamily !== slug) {
  const selectedSurface = proto.selected_surface_slug as string | undefined;
  const params = new URLSearchParams(Astro.url.search);
  if (selectedSurface) params.set('surface', selectedSurface);
  // Preserve legacy chain/deployment links for the client-side family selector
  // to normalize. It will discard ambiguous or stale selections safely.
  const query = params.toString();
  return Astro.redirect(`/protocols/${canonicalFamily}/${query ? `?${query}` : ''}`);
}
---

<ProtocolDetailLayout detail={detail} />

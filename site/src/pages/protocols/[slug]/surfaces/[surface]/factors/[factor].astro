---
import Base from '../../../../../../layouts/Base.astro';
import TopBar from '../../../../../../components/TopBar.astro';
import Breadcrumb from '../../../../../../components/Breadcrumb.astro';
import FactorCard from '../../../../../../components/FactorCard.astro';
import SourceList from '../../../../../../components/SourceList.astro';
import { listProtocols, getProtocol, getFactor } from '../../../../../../lib/data-loaders';
import { CATEGORIES } from '../../../../../../data/categories';
import { RUBRIC_VERSION } from '../../../../../../lib/rubric';
import { inlineMarkdown } from '../../../../../../lib/inline-md';
import { ISSUE_NEW_URL } from '../../../../../../lib/seo-defaults';

const FACTUAL_CORRECTION_URL = `${ISSUE_NEW_URL}?template=factual-correction.md`;

export async function getStaticPaths() {
  const paths: Array<{ params: { slug: string; surface: string; factor: string } }> = [];
  for (const p of listProtocols()) {
    const detail = getProtocol(p.slug);
    if (!detail) continue;
    const surfaces = (detail.surfaces ?? []) as Array<Record<string, unknown>>;
    for (const surface of surfaces) {
      const surfaceSlug = surface.surface_slug as string | undefined;
      if (!surfaceSlug) continue;
      const scores = (surface.factor_scores ?? []) as Array<Record<string, unknown>>;
      for (const score of scores) {
        const factorId = score.factor_id as string | undefined;
        if (!factorId) continue;
        paths.push({ params: { slug: p.slug, surface: surfaceSlug, factor: factorId } });
      }
    }
  }
  return paths;
}

const {
  slug,
  surface: surfaceSlug,
  factor: factorId,
} = Astro.params as {
  slug: string;
  surface: string;
  factor: string;
};
const protocolDetail = getProtocol(slug);
const factorDetail = getFactor(factorId);

if (!protocolDetail || !factorDetail) {
  return Astro.redirect('/404');
}

const proto = protocolDetail.protocol as Record<string, unknown>;
const displayName = (proto.display_name as string) ?? slug;
const surfaces = (protocolDetail.surfaces ?? []) as Array<Record<string, unknown>>;
const surface = surfaces.find((entry) => entry.surface_slug === surfaceSlug);

if (!surface) {
  return Astro.redirect(`/protocols/${slug}/`);
}

const surfaceName = (surface.display_name as string) ?? surfaceSlug;
const scores = (surface.factor_scores ?? []) as Array<Record<string, unknown>>;
const matching = scores.find((score) => score.factor_id === factorId);

if (!matching) {
  return Astro.redirect(`/protocols/${slug}/?surface=${encodeURIComponent(surfaceSlug)}`);
}

const f = factorDetail.factor;
const catName = CATEGORIES.find((c) => c.id === f.category_id)?.name ?? `Category ${f.category_id}`;
const score = (matching.score as string) ?? 'gray';
const evidenceSummary = (matching.evidence_summary as string) ?? '';
const evidenceDetail = (matching.evidence_detail as string) ?? '';
const sources = (
  (matching.sources ?? []) as Array<{
    source_type: string;
    url: string | null;
    reference?: string | null;
    title?: string | null;
    retrieved_at?: string | null;
  }>
).map((source, i) => ({ ...source, primary: i === 0 }));
---

<Base
  title={`${displayName} ${surfaceName} / ${f.id} / ${f.name}`}
  description={`${surfaceName} scored ${score} on ${f.id}: ${f.name}`}
>
  <TopBar slot="topbar" />

  <Breadcrumb
    items={[
      { n: 'Protocols', href: '/' },
      { n: displayName, href: `/protocols/${slug}/` },
      { n: surfaceName, href: `/protocols/${slug}/?surface=${surfaceSlug}` },
      { n: f.id },
    ]}
  />

  <div class="rdf-page">
    <aside class="rail">
      <FactorCard
        factorId={f.id}
        critical={f.is_critical}
        categoryName={catName}
        categoryHref={`/factors/?cat=${f.category_id}`}
        factorName={f.name}
        meta={[
          { label: 'Cadence', value: f.cadence ?? '-' },
          { label: 'Protocol', value: displayName },
          { label: 'Surface', value: surfaceName },
          {
            label: 'Score on this surface',
            value: score,
            crit: score === 'red',
          },
          {
            label: 'Last assessed',
            value: (matching.collected_at as string | undefined)?.slice(0, 10) ?? '-',
          },
          {
            label: 'Critical rule',
            value: f.is_critical ? 'Red blocks A; +5 risk points (15-point cap)' : 'Category rollup',
          },
        ]}
      />
    </aside>

    <div class="body">
      <div class="hero">
        <h1>
          {
            f.is_critical && (
              <span class="star-big" aria-label="Critical factor">
                *
              </span>
            )
          }
          <span>{f.name}</span>
        </h1>
        <p class="sub">
          {surfaceName} assessment for {f.id}, scored
          <span class:list={['pip', score]}>{score}</span>
          on the {RUBRIC_VERSION} rubric.
        </p>
      </div>

      {
        evidenceSummary && (
          <>
            <h2 id="evidence">
              Evidence summary{' '}
              <a class="alink" href="#evidence">
                #
              </a>
            </h2>
            <p set:html={inlineMarkdown(evidenceSummary)} />
          </>
        )
      }

      {
        evidenceDetail && (
          <>
            <h2 id="detail">
              Detail{' '}
              <a class="alink" href="#detail">
                #
              </a>
            </h2>
            <p set:html={inlineMarkdown(evidenceDetail)} />
          </>
        )
      }

      {
        sources.length > 0 && (
          <>
            <h2 id="sources">
              Sources{' '}
              <a class="alink" href="#sources">
                #
              </a>
            </h2>
            <SourceList sources={sources} />
          </>
        )
      }

      <h2 id="methodology">
        Methodology <a class="alink" href="#methodology">#</a>
      </h2>
      <p>{f.description}</p>
      <p>
        <a class="link" href={`/factors/${f.id}/`}>
          See the full factor methodology and distribution across all protocols
        </a>
      </p>

      <div class="envelope">
        <span><b>rubric_version</b> {RUBRIC_VERSION}</span>
        <span><b>protocol</b> {slug}</span>
        <span><b>surface</b> {surfaceSlug}</span>
        <span><b>factor</b> {f.id}</span>
        <span><b>score</b> {score}</span>
      </div>

      <p class="corrections-line">
        Spot an error in this assessment?
        <a class="link" href={FACTUAL_CORRECTION_URL}>Open a factual correction</a>.
      </p>
    </div>
  </div>
</Base>

<style>
  .rdf-page {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 0;
    align-items: flex-start;
  }
  .rail {
    position: sticky;
    top: 52px;
    align-self: flex-start;
    padding: 28px 26px;
    max-height: calc(100vh - 52px);
    overflow-y: auto;
    border-right: 1px solid var(--border);
    background: var(--surface);
    scrollbar-width: thin;
  }
  .body {
    padding: 34px 36px 80px;
    max-width: 820px;
  }
  .body .hero h1 {
    margin: 0;
    font-size: 30px;
    font-weight: 600;
    line-height: 1.1;
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--fg);
  }
  .star-big {
    color: var(--gF-text);
    font-size: 22px;
    line-height: 1;
  }
  .sub {
    font-size: 14px;
    color: var(--fg-2);
    margin: 12px 0 0;
    line-height: 1.55;
    max-width: 62ch;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .body h2 {
    margin: 36px 0 12px;
    font-size: 20px;
    font-weight: 600;
    color: var(--fg);
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .alink {
    font-family: 'Geist Mono', monospace;
    font-size: 13px;
    color: var(--fg-4);
    text-decoration: none;
    opacity: 0;
  }
  .body h2:hover .alink {
    opacity: 1;
  }
  .body h2 .alink:focus-visible {
    opacity: 1;
    color: var(--fg-2);
  }
  .body p {
    font-size: 14px;
    color: var(--fg-2);
    line-height: 1.7;
    margin: 0 0 12px;
    max-width: 62ch;
  }
  .link {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--border-2);
    text-underline-offset: 3px;
  }
  .pip {
    display: inline-flex;
    align-items: center;
    min-height: 20px;
    padding: 0 8px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    border-radius: 4px;
    border: 1px solid var(--border);
  }
  .pip.red {
    color: var(--gF-text);
    border-color: color-mix(in srgb, var(--gF) 45%, var(--border));
  }
  .pip.yellow {
    color: var(--gD-text);
    border-color: color-mix(in srgb, var(--gD) 45%, var(--border));
  }
  .pip.green {
    color: var(--gA-text);
    border-color: color-mix(in srgb, var(--gA) 45%, var(--border));
  }
  .envelope {
    margin-top: 36px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    font-family: 'Geist Mono', monospace;
    font-size: 11px;
    color: var(--fg-3);
  }
  .envelope b {
    color: var(--fg);
    font-weight: 600;
  }
  .body .corrections-line {
    margin-top: 12px;
    font-size: 12px;
    color: var(--fg-3);
  }

  @media (max-width: 820px) {
    .rdf-page {
      display: block;
    }
    .rail {
      position: static;
      max-height: none;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
    .body {
      padding: 28px 20px 64px;
    }
  }
</style>

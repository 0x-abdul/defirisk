---
import Base from '../../../../layouts/Base.astro';
import TopBar from '../../../../components/TopBar.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import FactorCard from '../../../../components/FactorCard.astro';
import SourceList from '../../../../components/SourceList.astro';
import { listPublishedProtocolSlugs, getProtocol, getFactor } from '../../../../lib/data-loaders';
import { CATEGORIES } from '../../../../data/categories';
import { RUBRIC_VERSION } from '../../../../lib/rubric';
import { inlineMarkdown } from '../../../../lib/inline-md';

export async function getStaticPaths() {
  const paths: Array<{ params: { slug: string; factor: string } }> = [];
  for (const slug of listPublishedProtocolSlugs()) {
    const detail = getProtocol(slug);
    if (!detail) continue;
    const scores = (detail.factor_scores ?? []) as Array<Record<string, unknown>>;
    for (const s of scores) {
      const fid = s.factor_id as string;
      if (!fid) continue;
      paths.push({ params: { slug, factor: fid } });
    }
  }
  return paths;
}

const { slug, factor: factorId } = Astro.params as { slug: string; factor: string };
const protocolDetail = getProtocol(slug);
const factorDetail = getFactor(factorId);

if (!protocolDetail || !factorDetail) {
  return Astro.redirect('/404');
}

const proto = protocolDetail.protocol as Record<string, unknown>;
const displayName = (proto.display_name as string) ?? slug;
const canonicalFamily = proto.canonical_family_slug as string | undefined;
const selectedSurface = proto.selected_surface_slug as string | undefined;

if (canonicalFamily && selectedSurface && canonicalFamily !== slug) {
  return Astro.redirect(
    `/protocols/${canonicalFamily}/surfaces/${encodeURIComponent(selectedSurface)}/factors/${factorId}/`
  );
}

const scores = (protocolDetail.factor_scores ?? []) as Array<Record<string, unknown>>;
const matching = scores.find((s) => s.factor_id === factorId);

if (!matching) {
  return Astro.redirect(`/protocols/${slug}/`);
}

const f = factorDetail.factor;
const catName = CATEGORIES.find((c) => c.id === f.category_id)?.name ?? `Category ${f.category_id}`;
const score = (matching.score as string) ?? 'gray';
const evidenceSummary = (matching.evidence_summary as string) ?? '';
const evidenceDetail = (matching.evidence_detail as string) ?? '';
const sources = (
  (matching.sources ?? []) as Array<{
    source_type: string;
    url: string | null;
    reference?: string | null;
    title?: string | null;
    retrieved_at?: string | null;
  }>
).map((s, i) => ({ ...s, primary: i === 0 }));
---

<Base
  title={`${displayName} · ${f.id} | ${f.name}`}
  description={`${displayName} scored ${score} on ${f.id}: ${f.name}`}
>
  <TopBar slot="topbar" />

  <Breadcrumb
    items={[
      { n: 'Protocols', href: '/' },
      { n: displayName, href: `/protocols/${slug}/` },
      { n: f.id },
    ]}
  />

  <div class="rdf-page">
    <aside class="rail">
      <FactorCard
        factorId={f.id}
        critical={f.is_critical}
        categoryName={catName}
        categoryHref={`/factors/?cat=${f.category_id}`}
        factorName={f.name}
        meta={[
          { label: 'Cadence', value: f.cadence ?? 'N/A' },
          { label: 'Protocol', value: displayName },
          {
            label: 'Score on this protocol',
            value: score,
            crit: score === 'red',
          },
          {
            label: 'Last assessed',
            value: (matching.collected_at as string | undefined)?.slice(0, 10) ?? 'N/A',
          },
          {
            label: 'Critical rule',
            value: f.is_critical ? 'Red blocks A; +5 risk points (15-point cap)' : 'Category rollup',
          },
        ]}
      />
    </aside>

    <main class="body">
      <div class="hero">
        <h1>
          {
            f.is_critical && (
              <span class="star-big" aria-label="Critical factor">
                ★
              </span>
            )
          }
          <span>{f.name}</span>
        </h1>
        <p class="sub">
          {displayName}'s assessment for {f.id}, scored
          <span class:list={['pip', score]}>{score}</span>
          on the {RUBRIC_VERSION} rubric. The evidence below is the curator's reasoning for this score.
        </p>
      </div>

      {
        evidenceSummary && (
          <>
            <h2 id="evidence">
              Evidence summary{' '}
              <a class="alink" href="#evidence">
                #
              </a>
            </h2>
            <p set:html={inlineMarkdown(evidenceSummary)} />
          </>
        )
      }

      {
        evidenceDetail && (
          <>
            <h2 id="detail">
              Detail{' '}
              <a class="alink" href="#detail">
                #
              </a>
            </h2>
            <p set:html={inlineMarkdown(evidenceDetail)} />
          </>
        )
      }

      {
        sources.length > 0 && (
          <>
            <h2 id="sources">
              Sources{' '}
              <a class="alink" href="#sources">
                #
              </a>
            </h2>
            <SourceList sources={sources} />
          </>
        )
      }

      <h2 id="methodology">
        Methodology <a class="alink" href="#methodology">#</a>
      </h2>
      <p>{f.description}</p>
      <p>
        <a class="link" href={`/factors/${f.id}/`}>
          See the full factor methodology and distribution across all protocols →
        </a>
      </p>

      <div class="envelope">
        <span><b>rubric_version</b> {RUBRIC_VERSION}</span>
        <span><b>protocol</b> {slug}</span>
        <span><b>factor</b> {f.id}</span>
        <span><b>score</b> {score}</span>
        <span
          ><b>collected_at</b>
          {
            (matching.collected_at as string | undefined)?.slice(0, 19).replace('T', ' ') ?? 'N/A'
          }</span
        >
      </div>
    </main>
  </div>
</Base>

<style>
  .rdf-page {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 0;
    align-items: flex-start;
  }
  .rail {
    position: sticky;
    top: 52px;
    align-self: flex-start;
    padding: 28px 26px;
    max-height: calc(100vh - 52px);
    overflow-y: auto;
    border-right: 1px solid var(--border);
    background: var(--surface);
    scrollbar-width: thin;
  }
  .body {
    padding: 34px 36px 80px;
    max-width: 820px;
  }
  .body .hero h1 {
    margin: 0;
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
    text-wrap: balance;
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--fg);
  }
  .body .hero h1 .star-big {
    color: var(--gF);
    font-size: 22px;
    line-height: 1;
  }
  .body .hero .sub {
    font-size: 14px;
    color: var(--fg-2);
    margin: 12px 0 0;
    line-height: 1.55;
    max-width: 62ch;
    text-wrap: pretty;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .body h2 {
    margin: 36px 0 12px;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--fg);
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .body h2 .alink {
    font-family: 'Geist Mono', monospace;
    font-size: 13px;
    color: var(--fg-4);
    text-decoration: none;
    opacity: 0;
  }
  .body h2:hover .alink {
    opacity: 1;
  }
  .body p {
    font-size: 14px;
    color: var(--fg-2);
    line-height: 1.7;
    margin: 0 0 12px;
    max-width: 62ch;
    text-wrap: pretty;
  }
  .body .link {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--border-2);
    text-underline-offset: 3px;
  }
  .pip {
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding: 0 8px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 4px;
  }
  .pip.red {
    color: var(--gF);
    background: var(--gF-bg);
  }
  .pip.yellow {
    color: var(--gC);
    background: var(--gC-bg);
  }
  .pip.green {
    color: var(--gA);
    background: var(--gA-bg);
  }
  .pip.gray {
    color: var(--fg-3);
    background: var(--surface-2);
  }
  .envelope {
    margin-top: 36px;
    padding: 14px 16px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    font-family: 'Geist Mono', monospace;
    font-size: 11px;
    color: var(--fg-3);
    letter-spacing: 0.01em;
  }
  .envelope b {
    color: var(--fg);
    font-weight: 500;
    margin-right: 6px;
  }

  @media (max-width: 900px) {
    .rdf-page {
      grid-template-columns: 1fr;
    }
    .rail {
      position: static;
      max-height: none;
      overflow: visible;
      border-right: none;
      border-bottom: 1px solid var(--border);
      padding: 24px 18px;
    }
    .body {
      padding: 24px 18px 48px;
      max-width: 100%;
    }
    .body .hero h1 {
      font-size: 24px;
      flex-wrap: wrap;
    }
  }
</style>

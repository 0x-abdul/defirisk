---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import { getStatusSummary } from '../lib/data-loaders';
import {
  CADENCE_BUCKETS,
  COVERAGE_TARGET_FACTORS,
  COVERAGE_TARGET_CATEGORIES,
} from '../lib/status-thresholds';

const status = getStatusSummary();
const generatedAtDisplay = status.generated_at
  ? status.generated_at.slice(0, 19).replace('T', ' ') + ' UTC'
  : 'N/A';
const dataAsOfDisplay = status.data_as_of
  ? status.data_as_of.slice(0, 19).replace('T', ' ') + ' UTC'
  : 'N/A';
const rubricFrozenDisplay = status.rubric_frozen_at
  ? status.rubric_frozen_at.slice(0, 10)
  : 'N/A';

const coveragePctProtocols =
  status.protocols_target > 0
    ? Math.round((status.protocols_graded / status.protocols_target) * 100)
    : 0;
const coveragePctCritical =
  status.critical_factors_target > 0
    ? Math.round(
        (status.critical_factors_covered / status.critical_factors_target) * 100,
      )
    : 0;

const bucketRows = CADENCE_BUCKETS.map((bucket) => ({
  ...bucket,
  count: status.cadence_counts[bucket.code],
}));
---

<Base
  title="System status"
  description="Reviewed public snapshot, coverage, and factor cadence for the DeFi Risk dashboard."
>
  <TopBar slot="topbar" />

  <div class="container">
    <div class="masthead">
      <div class="crumb">System status</div>
      <h1>System status</h1>
      <p class="lede">
        A reviewed public snapshot of the dashboard, its coverage target, and the cadence assigned
        to each factor. Values below come from the versioned API projection at build time.
      </p>
      <div class="meta-row">
        <span><b>Rubric</b> {status.rubric_version}</span>
        <span><b>API envelope</b> {status.api_envelope_version}</span>
        <span><b>Build</b> <code>{status.build_sha ?? 'N/A'}</code></span>
        <span><b>Generated</b> {generatedAtDisplay}</span>
      </div>
    </div>

    <section class="section">
      <div class="section-head"><span class="section-num">§01</span><h2>Reviewed snapshot</h2></div>
      <table class="mtable">
        <tbody>
          <tr>
            <th scope="row">Rubric version</th>
            <td><code>{status.rubric_version}</code> · <a href="/methodology/#changelog">changelog</a></td>
          </tr>
          <tr>
            <th scope="row">API envelope version</th>
            <td>
              <code>{status.api_envelope_version}</code> ·
              <a href={`/api/${status.api_envelope_version}/schema/envelope.json`}>envelope schema</a>
            </td>
          </tr>
          <tr><th scope="row">Rubric frozen at</th><td>{rubricFrozenDisplay}</td></tr>
          <tr><th scope="row">Data as of</th><td><code>{dataAsOfDisplay}</code></td></tr>
          <tr>
            <th scope="row">Build commit</th>
            <td><code>{status.build_sha ?? 'N/A (set PUBLIC_GIT_SHA at build time)'}</code></td>
          </tr>
          <tr><th scope="row">Projection generated at</th><td><code>{generatedAtDisplay}</code></td></tr>
        </tbody>
      </table>
    </section>

    <section class="section">
      <div class="section-head"><span class="section-num">§02</span><h2>Coverage</h2></div>
      <div class="coverage-grid">
        <div class="coverage-cell">
          <div class="coverage-num">{status.protocols_graded} <span class="muted">/ {status.protocols_target}</span></div>
          <div class="coverage-label">Published protocols</div>
          <div class="coverage-meta">{coveragePctProtocols}% of the fixed target · {status.protocols_pending} remaining</div>
        </div>
        <div class="coverage-cell">
          <div class="coverage-num">{status.critical_factors_covered} <span class="muted">/ {status.critical_factors_target}</span></div>
          <div class="coverage-label">Critical ★ factors in taxonomy</div>
          <div class="coverage-meta">{coveragePctCritical}% of the active critical-factor set</div>
        </div>
        <div class="coverage-cell">
          <div class="coverage-num">{COVERAGE_TARGET_FACTORS}</div>
          <div class="coverage-label">Total factors in taxonomy</div>
          <div class="coverage-meta">across {COVERAGE_TARGET_CATEGORIES} categories</div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><span class="section-num">§03</span><h2>Cadence buckets</h2><span class="tag">factor schedule</span></div>
      <p class="muted">
        Every factor in the {COVERAGE_TARGET_FACTORS}-factor taxonomy is assigned a cadence.
        Counts are derived from the current v1.7.0 factor detail metadata at build time, with an
        exact total assertion.
      </p>
      <div class="table-scroll" role="region" aria-label="Cadence bucket table" tabindex="0">
        <table class="mtable">
          <thead>
            <tr>
              <th>Code</th>
              <th>Bucket</th>
              <th class="num">Factors</th>
              <th>Refresh model</th>
              <th>SLA</th>
            </tr>
          </thead>
          <tbody>
            {bucketRows.map((bucket) => (
              <tr>
                <td class="mono"><b>{bucket.code}</b></td>
                <td>{bucket.label}</td>
                <td class="num">{bucket.count}</td>
                <td>{bucket.refresh}</td>
                <td class="muted">{bucket.sla}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted">Examples and full per-factor mapping: see <a href="/methodology/">methodology</a>.</p>
    </section>

    <section class="section">
      <div class="section-head"><span class="section-num">§04</span><h2>Public snapshot notes</h2></div>
      <p class="muted">
        This page describes the committed reviewed projection. It is not a live operations monitor
        and does not include private review or ingestion telemetry.
      </p>
      <p class="muted">Real-time signals remain deferred to v1.1 and will be surfaced by the signal engine.</p>
    </section>

    <div class="envelope">
      <span><b>rubric_version</b> {status.rubric_version}</span>
      <span><b>api_envelope_version</b> {status.api_envelope_version}</span>
      <span><b>data_as_of</b> {status.data_as_of || 'N/A'}</span>
      <span><b>generated_at</b> {status.generated_at || 'N/A'}</span>
      <span><b>protocols_graded</b> {status.protocols_graded}/{status.protocols_target}</span>
    </div>
  </div>

  <Footer slot="footer" buildSha={status.build_sha ?? undefined} />
</Base>

<style>
  .container {
    width: min(1120px, 100%);
    margin: 0 auto;
    padding: var(--s-13) var(--s-10) var(--s-14);
    min-width: 0;
  }
  .masthead {
    padding-bottom: var(--s-10);
    border-bottom: 1px solid var(--border);
  }
  .crumb,
  .section-num,
  .tag,
  .meta-row,
  .envelope,
  .mono {
    font-family: var(--font-mono);
  }
  .crumb,
  .section-num {
    color: var(--fg-3);
    font-size: var(--t-cap);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
  }
  .masthead h1 {
    margin-top: var(--s-3);
    color: var(--fg);
    font-size: var(--t-4xl);
    font-weight: var(--w-semi);
    letter-spacing: var(--ls-display);
    line-height: 1.1;
  }
  .lede {
    max-width: 70ch;
    margin-top: var(--s-5);
    color: var(--fg-2);
    font-size: var(--t-md);
    line-height: 1.6;
  }
  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    margin-top: var(--s-7);
    color: var(--fg-3);
    font-size: var(--t-cap);
  }
  .meta-row b {
    color: var(--fg-2);
    font-weight: var(--w-medium);
  }
  .meta-row code,
  .mtable code {
    color: var(--fg);
    font-family: var(--font-mono);
  }
  .section {
    margin-top: var(--s-13);
  }
  .section-head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
  }
  .section-head h2 {
    color: var(--fg);
    font-size: var(--t-2xl);
    font-weight: var(--w-semi);
    letter-spacing: var(--ls-snug);
  }
  .tag {
    margin-left: auto;
    color: var(--fg-3);
    font-size: var(--t-micro);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
  }
  .mtable {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-3);
    overflow: hidden;
  }
  .mtable th,
  .mtable td {
    padding: var(--s-5) var(--s-6);
    border-bottom: 1px solid var(--border);
    color: var(--fg-2);
    font-size: var(--t-base);
    line-height: 1.5;
    text-align: left;
    vertical-align: top;
  }
  .mtable tr:last-child th,
  .mtable tr:last-child td {
    border-bottom: 0;
  }
  .mtable th {
    width: 32%;
    color: var(--fg-3);
    font-weight: var(--w-medium);
  }
  .mtable thead th {
    background: var(--surface-2);
    color: var(--fg-3);
    font-family: var(--font-mono);
    font-size: var(--t-cap);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
  }
  .mtable .num {
    font-family: var(--font-mono);
    font-feature-settings: 'tnum';
    text-align: right;
    white-space: nowrap;
  }
  .mtable a,
  .muted a {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .coverage-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--s-5);
  }
  .coverage-cell {
    padding: var(--s-7);
    border: 1px solid var(--border);
    border-radius: var(--r-3);
    background: var(--surface-2);
  }
  .coverage-num {
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--t-3xl);
    font-weight: var(--w-semi);
    line-height: 1.1;
  }
  .coverage-num .muted {
    color: var(--fg-3);
    font-weight: var(--w-regular);
  }
  .coverage-label {
    margin-top: var(--s-2);
    color: var(--fg-2);
    font-weight: var(--w-medium);
  }
  .coverage-meta,
  .muted {
    color: var(--fg-3);
    font-size: var(--t-sm);
  }
  .coverage-meta {
    margin-top: var(--s-1);
  }
  .table-scroll {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--r-3);
    background: var(--surface);
  }
  .table-scroll:focus-visible {
    outline: 2px solid var(--fg-2);
    outline-offset: 2px;
  }
  .table-scroll .mtable {
    min-width: 720px;
    border: 0;
    border-radius: 0;
  }
  .envelope {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-7);
    margin-top: var(--s-13);
    padding-top: var(--s-5);
    border-top: 1px solid var(--border);
    color: var(--fg-3);
    font-size: var(--t-micro);
  }
  .envelope b {
    color: var(--fg-2);
    font-weight: var(--w-medium);
  }
  @media (max-width: 700px) {
    .container {
      padding: var(--s-10) var(--s-5) var(--s-13);
    }
    .masthead h1 {
      font-size: var(--t-3xl);
    }
    .section-head h2 {
      font-size: var(--t-xl);
    }
    .mtable th,
    .mtable td {
      padding: var(--s-4) var(--s-5);
    }
  }
</style>

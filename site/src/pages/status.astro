---
import Base from '../layouts/Base.astro';
import { getStatusSummary } from '../lib/data-loaders';
import { RUBRIC_VERSION } from '../lib/rubric';
import {
  CADENCE_BUCKETS,
  COVERAGE_TARGET_FACTORS,
  COVERAGE_TARGET_CATEGORIES,
  FRESHNESS_GREEN_DAYS,
  FRESHNESS_YELLOW_DAYS,
  classifyFreshness,
} from '../lib/status-thresholds';

const status = getStatusSummary();
const buildSha = import.meta.env.PUBLIC_GIT_SHA;
const generatedAtDisplay = status.generated_at.slice(0, 19).replace('T', ' ') + ' UTC';
const rubricFrozenDisplay = status.rubric_frozen_at
  ? status.rubric_frozen_at.slice(0, 10)
  : 'N/A';

const coveragePctProtocols =
  status.protocols_target > 0
    ? Math.round((status.protocols_graded / status.protocols_target) * 100)
    : 0;
const coveragePctCritical =
  status.critical_factors_target > 0
    ? Math.round(
        (status.critical_factors_covered / status.critical_factors_target) * 100,
      )
    : 0;

const freshnessCounts = status.per_protocol.reduce(
  (acc, p) => {
    const c = classifyFreshness(p.days_stale);
    acc[c] = (acc[c] ?? 0) + 1;
    return acc;
  },
  { green: 0, yellow: 0, red: 0, gray: 0 } as Record<string, number>,
);
---

<Base
  title="System status | DeFi Risk"
  description="Live operational status: rubric version, build SHA, fleet freshness, per-protocol last-updated timestamps, and pipeline run history."
>
  <div class="container">
    <div class="masthead">
      <div class="crumb">System status</div>
      <h1>Status</h1>
      <p class="lede">What version of the dashboard you're reading, when the data was last refreshed, and the health of the ingestion pipeline. This page is regenerated every nightly build; see "generated at" below.</p>
      <div class="meta-row">
        <span><b>Rubric</b> {RUBRIC_VERSION}</span>
        <span><b>Schema</b> {status.schema_version}</span>
        <span><b>Build</b> <code>{buildSha ?? 'N/A'}</code></span>
        <span><b>Generated</b> {generatedAtDisplay}</span>
      </div>
    </div>

    <section class="section">
      <div class="section-head"><span class="section-num">§01</span><h2>System version</h2></div>
      <table class="mtable">
        <tbody>
          <tr><th scope="row">Rubric version</th><td><code>{RUBRIC_VERSION}</code> · <a href="/methodology/#changelog">changelog</a></td></tr>
          <tr><th scope="row">Rubric frozen at</th><td>{rubricFrozenDisplay}</td></tr>
          <tr><th scope="row">DB schema version</th><td><code>{status.schema_version}</code> · <a href={`/api/${RUBRIC_VERSION}/schema/envelope.json`}>envelope schema</a></td></tr>
          <tr><th scope="row">Build commit</th><td><code>{buildSha ?? 'N/A (set PUBLIC_GIT_SHA at build time)'}</code></td></tr>
          <tr><th scope="row">Coverage target</th><td>{COVERAGE_TARGET_CATEGORIES} categories · {COVERAGE_TARGET_FACTORS} factors · {status.critical_factors_target} critical ★</td></tr>
          <tr><th scope="row">Page generated at</th><td><code>{status.generated_at}</code></td></tr>
        </tbody>
      </table>
    </section>

    <section class="section">
      <div class="section-head"><span class="section-num">§02</span><h2>Coverage</h2></div>
      <div class="coverage-grid">
        <div class="coverage-cell">
          <div class="coverage-num">{status.protocols_graded} <span class="muted">/ {status.protocols_target}</span></div>
          <div class="coverage-label">Protocols graded</div>
          <div class="coverage-meta">{coveragePctProtocols}% · {status.protocols_pending} pending M3a</div>
        </div>
        <div class="coverage-cell">
          <div class="coverage-num">{status.critical_factors_covered} <span class="muted">/ {status.critical_factors_target}</span></div>
          <div class="coverage-label">Critical ★ factors loaded</div>
          <div class="coverage-meta">{coveragePctCritical}% of the single-factor-sufficient set</div>
        </div>
        <div class="coverage-cell">
          <div class="coverage-num">{COVERAGE_TARGET_FACTORS}</div>
          <div class="coverage-label">Total factors in taxonomy</div>
          <div class="coverage-meta">across {COVERAGE_TARGET_CATEGORIES} categories</div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><span class="section-num">§03</span><h2>Per-protocol freshness</h2><span class="tag">{status.per_protocol.length} protocols</span></div>

      {status.per_protocol.length === 0 ? (
        <div class="empty-state">
          <p><b>No protocols graded yet.</b> Once M3a (E-18) lands, every protocol's slug, letter grade, last-graded-at, and data-as-of timestamps will appear here, sorted with the most stale rows first.</p>
          <p class="muted">Color legend: green ≤{FRESHNESS_GREEN_DAYS}d · yellow {FRESHNESS_GREEN_DAYS + 1}–{FRESHNESS_YELLOW_DAYS}d · red &gt;{FRESHNESS_YELLOW_DAYS}d · gray ungraded.</p>
        </div>
      ) : (
        <>
          <div class="freshness-summary">
            <span class="dot dot-green" aria-hidden="true"></span> {freshnessCounts.green} fresh
            <span class="sep">·</span>
            <span class="dot dot-yellow" aria-hidden="true"></span> {freshnessCounts.yellow} aging
            <span class="sep">·</span>
            <span class="dot dot-red" aria-hidden="true"></span> {freshnessCounts.red} stale
            <span class="sep">·</span>
            <span class="dot dot-gray" aria-hidden="true"></span> {freshnessCounts.gray} ungraded
          </div>
          <table class="mtable freshness-table">
            <thead>
              <tr>
                <th>Protocol</th>
                <th>Letter</th>
                <th>Graded at</th>
                <th>Data as of</th>
                <th class="num">Days stale</th>
              </tr>
            </thead>
            <tbody>
              {status.per_protocol.map((p) => {
                const fc = classifyFreshness(p.days_stale);
                return (
                  <tr class={`freshness-row freshness-${fc}`}>
                    <td><a href={`/protocols/${p.slug}/`}>{p.display_name}</a></td>
                    <td class="mono">{p.letter ?? 'N/A'}</td>
                    <td class="mono">{p.graded_at?.slice(0, 10) ?? 'N/A'}</td>
                    <td class="mono">{p.data_as_of?.slice(0, 10) ?? 'N/A'}</td>
                    <td class="num mono">{p.days_stale ?? 'N/A'}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </>
      )}
    </section>

    <section class="section">
      <div class="section-head"><span class="section-num">§04</span><h2>Cadence buckets</h2><span class="tag">refresh schedule</span></div>
      <p class="muted">Every factor in the 184-factor taxonomy is annotated with a refresh cadence. The dashboard's pipeline runs the right script at the right interval; most factors don't need to be re-checked nightly. Bucket counts are derived from the cadence column in the methodology template.</p>
      <table class="mtable">
        <thead>
          <tr>
            <th>Code</th>
            <th>Bucket</th>
            <th class="num">Factors</th>
            <th>Refresh model</th>
            <th>SLA</th>
          </tr>
        </thead>
        <tbody>
          {CADENCE_BUCKETS.map((b) => (
            <tr>
              <td class="mono"><b>{b.code}</b></td>
              <td>{b.label}</td>
              <td class="num">{b.count}</td>
              <td>{b.refresh}</td>
              <td class="muted">{b.sla}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="muted">Examples and full per-factor mapping: see <a href="/methodology/">methodology</a>.</p>
    </section>

    <section class="section">
      <div class="section-head"><span class="section-num">§05</span><h2>Pipeline run history</h2><span class="tag">{status.pipeline_runs_source === 'live' ? `${status.pipeline_runs.length} runs` : 'unwired'}</span></div>
      {status.pipeline_runs_source === 'unwired' ? (
        <div class="empty-state">
          <p><b>Run history not yet wired.</b> When E-30 Phase 3 lands, this section renders the last 30 invocations of <code>refresh-continuous.py</code> and <code>refresh-events.py</code>, with per-fetcher success/error counts, protocols touched, and duration.</p>
          <p class="muted">Until then, freshness above is computed directly from per-protocol envelopes (graded_at / data_as_of), not from a separate run log.</p>
        </div>
      ) : (
        <table class="mtable">
          <thead>
            <tr>
              <th>Run at</th>
              <th>Script</th>
              <th>Bucket</th>
              <th class="num">Protocols</th>
              <th class="num">OK</th>
              <th class="num">Err</th>
              <th class="num">Duration</th>
              <th>Trigger</th>
            </tr>
          </thead>
          <tbody>
            {status.pipeline_runs.map((r) => (
              <tr>
                <td class="mono">{r.run_at.slice(0, 19).replace('T', ' ')}</td>
                <td class="mono">{r.script_name}</td>
                <td class="mono">{r.cadence_bucket ?? 'N/A'}</td>
                <td class="num">{r.protocols_touched}</td>
                <td class="num">{r.success_count}</td>
                <td class="num">{r.error_count}</td>
                <td class="num">{r.duration_seconds == null ? 'N/A' : `${r.duration_seconds}s`}</td>
                <td class="muted">{r.triggered_by}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </section>

    <section class="section">
      <div class="section-head"><span class="section-num">§06</span><h2>Data freshness policy</h2></div>
      <ul class="policy">
        <li><b>Green</b>: last-updated within {FRESHNESS_GREEN_DAYS} days. Treat as current.</li>
        <li><b>Yellow</b>: {FRESHNESS_GREEN_DAYS + 1} to {FRESHNESS_YELLOW_DAYS} days. Episodic factors expected to land here between weekly sweeps; static factors are normal at any age.</li>
        <li><b>Red</b>: &gt; {FRESHNESS_YELLOW_DAYS} days for a continuous-cadence factor, or &gt; 90 days for an episodic factor. Surface as a stale-data flag on the protocol page.</li>
        <li><b>Gray</b>: never assessed. Pre-M3a state for new protocols.</li>
      </ul>
      <p class="muted">Active incidents are surfaced via the per-protocol incident banner and do <em>not</em> change the structural letter grade (PD-033). The EVENT badge mechanism returns alongside the v1.1 streaming-signal engine.</p>
    </section>

    <div class="envelope">
      <span><b>rubric_version</b> {RUBRIC_VERSION}</span>
      <span><b>schema_version</b> {status.schema_version}</span>
      <span><b>generated_at</b> {status.generated_at}</span>
      <span><b>protocols_graded</b> {status.protocols_graded}/{status.protocols_target}</span>
    </div>
  </div>
</Base>

<style>
  .coverage-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--s-4);
    margin-top: var(--s-3);
  }
  .coverage-cell {
    border: 1px solid var(--n-200);
    padding: var(--s-4);
    border-radius: 4px;
    background: var(--n-50);
  }
  .coverage-num {
    font-family: var(--mono);
    font-size: var(--t-2xl, 1.75rem);
    font-weight: 600;
    color: var(--n-900);
    line-height: 1.1;
  }
  .coverage-num .muted { color: var(--n-500); font-weight: 400; }
  .coverage-label { color: var(--n-700); margin-top: 4px; font-weight: 500; }
  .coverage-meta { color: var(--n-500); font-size: var(--t-xs); margin-top: 2px; }

  .freshness-summary {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
    color: var(--n-700);
    font-size: var(--t-sm);
    margin-bottom: var(--s-3);
  }
  .freshness-summary .sep { color: var(--n-300); margin: 0 4px; }
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 4px;
  }
  .dot-green { background: var(--cell-green, #22c55e); }
  .dot-yellow { background: var(--cell-yellow, #eab308); }
  .dot-red { background: var(--cell-red, #ef4444); }
  .dot-gray { background: var(--n-300); }

  .freshness-table th, .freshness-table td { padding: 6px 12px; }
  .freshness-row td { border-bottom: 1px solid var(--n-100); }
  .freshness-green td:first-child { border-left: 3px solid var(--cell-green, #22c55e); }
  .freshness-yellow td:first-child { border-left: 3px solid var(--cell-yellow, #eab308); }
  .freshness-red td:first-child { border-left: 3px solid var(--cell-red, #ef4444); }
  .freshness-gray td:first-child { border-left: 3px solid var(--n-300); }

  .empty-state {
    border: 1px dashed var(--n-300);
    padding: var(--s-4);
    border-radius: 4px;
    background: var(--n-50);
  }
  .empty-state p:first-child { margin-top: 0; }
  .empty-state p:last-child { margin-bottom: 0; }

  .policy { padding-left: var(--s-4); }
  .policy li { margin-bottom: 8px; color: var(--n-700); }
</style>

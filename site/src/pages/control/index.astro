---
/**
 * Owner-only control index — review-link directory.
 *
 * Lists every protocol currently in pre-publication review with its
 * unguessable /unpublished/<slug>-<token>/ URL (the link to send each
 * protocol team), plus the protocols already published. The page exists so
 * the curator can grab review links without touching the DB or the JSON tree.
 *
 * ACCESS CONTROL — this page is NOT self-protecting. It must be gated by
 * HTTP Basic Auth at the web-server level on /control/. The hardening below
 * only keeps it out of crawlers and out of any on-site link graph:
 *   - <Base noindex />            → <meta name="robots" noindex,nofollow>
 *   - site/public/robots.txt      → Disallow: /control/
 *   - site/astro.config.mjs       → sitemap filter excludes /control/
 *   - never linked from anywhere on the public site
 *
 * Without the server-side auth block the static HTML (and every review link in
 * it) is readable by anyone who guesses the path. Do not deploy /control/
 * without it.
 */
import Base from '../../layouts/Base.astro';
import { SITE_URL } from '../../lib/seo-defaults';
import { RUBRIC_VERSION } from '../../lib/rubric';
import {
  listUnpublishedReviewEntries,
  listPublishedProtocolSlugs,
  getProtocolByReviewPath,
  getProtocol,
} from '../../lib/data-loaders';

interface ReviewRow {
  display_name: string;
  slug: string;
  grade: string | null;
  reviewUrl: string;
}

const inReview: ReviewRow[] = listUnpublishedReviewEntries()
  .map((review) => {
    const detail = getProtocolByReviewPath(review);
    const proto = (detail?.protocol ?? {}) as Record<string, unknown>;
    return {
      display_name: (proto.display_name as string) ?? review,
      slug: (proto.slug as string) ?? review,
      grade: (proto.headline_grade as string | null) ?? null,
      reviewUrl: `${SITE_URL}/unpublished/${review}/`,
    };
  })
  .sort((a, b) => a.display_name.localeCompare(b.display_name));

interface PublishedRow {
  display_name: string;
  slug: string;
  grade: string | null;
}

const published: PublishedRow[] = listPublishedProtocolSlugs()
  .map((slug) => {
    const detail = getProtocol(slug);
    const proto = (detail?.protocol ?? {}) as Record<string, unknown>;
    return {
      display_name: (proto.display_name as string) ?? slug,
      slug,
      grade: (proto.headline_grade as string | null) ?? null,
    };
  })
  .sort((a, b) => a.display_name.localeCompare(b.display_name));
---

<Base title="Control — review links" noindex>
  <div class="wrap">
    <header class="head">
      <h1>Review-link control</h1>
      <p class="sub">
        Private. Protected by Nginx Basic Auth — not linked anywhere, noindex.
        Rubric {RUBRIC_VERSION}.
      </p>
      <div class="counts">
        <span><b>{inReview.length}</b> in review</span>
        <span><b>{published.length}</b> published</span>
        <span><b>{inReview.length + published.length}</b> total</span>
      </div>
    </header>

    <section>
      <h2>In review — send these links ({inReview.length})</h2>
      {inReview.length === 0 ? (
        <p class="empty">No protocols are currently unpublished.</p>
      ) : (
        <table>
          <thead>
            <tr><th>Protocol</th><th>Slug</th><th>Grade</th><th>Review link</th><th></th></tr>
          </thead>
          <tbody>
            {inReview.map((r) => (
              <tr>
                <td class="name">{r.display_name}</td>
                <td class="mono">{r.slug}</td>
                <td class="mono">{r.grade ?? '—'}</td>
                <td class="mono link">
                  <a href={r.reviewUrl} target="_blank" rel="noopener">{r.reviewUrl}</a>
                </td>
                <td>
                  <button type="button" class="copy" data-copy={r.reviewUrl}>Copy</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </section>

    <section>
      <h2>Published — live on the public site ({published.length})</h2>
      {published.length === 0 ? (
        <p class="empty">Nothing published yet.</p>
      ) : (
        <table>
          <thead>
            <tr><th>Protocol</th><th>Slug</th><th>Grade</th><th>Public page</th></tr>
          </thead>
          <tbody>
            {published.map((r) => (
              <tr>
                <td class="name">{r.display_name}</td>
                <td class="mono">{r.slug}</td>
                <td class="mono">{r.grade ?? '—'}</td>
                <td class="mono link">
                  <a href={`/protocols/${r.slug}/`} target="_blank" rel="noopener">
                    /protocols/{r.slug}/
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </section>

    <footer class="foot">
      <p>
        Publish a protocol: <code>python scripts/set_published.py {'<slug>'} --on --dump</code>
        then rebuild. It moves from the review link to <code>/protocols/{'<slug>'}/</code>.
      </p>
    </footer>
  </div>
</Base>

<script is:inline>
  document.querySelectorAll('button.copy').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var url = btn.getAttribute('data-copy') || '';
      navigator.clipboard.writeText(url).then(function () {
        var prev = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(function () { btn.textContent = prev; }, 1200);
      });
    });
  });
</script>

<style>
  .wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 24px 64px;
  }
  .head h1 {
    margin: 0;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .head .sub {
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--fg-3);
  }
  .head .counts {
    margin: 14px 0 0;
    display: flex;
    gap: 18px;
    font-size: 12.5px;
    color: var(--fg-2);
    font-family: 'Geist Mono', monospace;
  }
  .head .counts b {
    color: var(--fg);
  }
  section {
    margin-top: 32px;
  }
  section h2 {
    margin: 0 0 12px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .empty {
    font-size: 13px;
    color: var(--fg-3);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    font-size: 12.5px;
  }
  thead th {
    text-align: left;
    background: var(--surface-2);
    color: var(--fg-3);
    font-weight: 600;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
  }
  tbody td {
    padding: 9px 12px;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }
  tbody tr:last-child td {
    border-bottom: none;
  }
  tbody tr:hover {
    background: var(--surface-2);
  }
  .name {
    font-weight: 500;
    color: var(--fg);
  }
  .mono {
    font-family: 'Geist Mono', monospace;
    color: var(--fg-2);
  }
  .link a {
    color: var(--fg);
    text-decoration: none;
    word-break: break-all;
  }
  .link a:hover {
    text-decoration: underline;
  }
  button.copy {
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--surface);
    color: var(--fg);
    font-size: 11.5px;
    font-weight: 500;
    cursor: pointer;
  }
  button.copy:hover {
    background: var(--surface-2);
  }
  .foot {
    margin-top: 32px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    color: var(--fg-3);
  }
  .foot code {
    font-family: 'Geist Mono', monospace;
    background: var(--surface-2);
    padding: 1px 5px;
    border-radius: 3px;
    border: 1px solid var(--border);
  }
</style>

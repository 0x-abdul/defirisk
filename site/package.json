{
  "name": "defirisk-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node ./scripts/post-build-copy.mjs && node ./scripts/build-og-images.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test --config=playwright.config.ts",
    "test:visual:update": "playwright test --config=playwright.config.ts --update-snapshots",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "perf:desktop": "lhci collect --config=./lighthouserc.desktop.json && lhci assert --config=./lighthouserc.desktop.json",
    "perf:mobile": "lhci collect --config=./lighthouserc.mobile.json && lhci assert --config=./lighthouserc.mobile.json",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/preact": "^5.1.5",
    "@astrojs/sitemap": "~3.2.0",
    "@fontsource/geist": "^5.2.9",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "preact": "^10.29.2",
    "satori": "^0.26.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^2.1.0",
    "astro": "^4.16.0",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vitest": "^2.1.0"
  }
}

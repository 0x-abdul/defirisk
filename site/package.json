{
  "name": "defirisk-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node ./scripts/run-private-safe-build.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test --config=playwright.config.ts",
    "test:visual:update": "playwright test --config=playwright.config.ts --update-snapshots",
    "test:a11y": "node ./scripts/run-playwright-with-preview.mjs playwright.a11y.config.ts",
    "test:smoke": "node ./scripts/run-playwright-with-preview.mjs playwright.smoke.config.ts",
    "perf:desktop": "lhci collect --config=./lighthouserc.desktop.json && lhci assert --config=./lighthouserc.desktop.json",
    "perf:mobile": "lhci collect --config=./lighthouserc.mobile.json && lhci assert --config=./lighthouserc.mobile.json",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/preact": "^5.1.5",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/geist": "^5.2.9",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "preact": "^10.29.2",
    "satori": "^0.28.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "^2.1.0",
    "astro": "^7.0.6",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^2.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}

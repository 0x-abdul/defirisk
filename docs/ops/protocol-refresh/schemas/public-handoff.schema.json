{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://defirisk.co/schemas/protocol-refresh/public-handoff.schema.json",
  "title": "Non-authorizing public protocol refresh handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "refresh_id",
    "family_slug",
    "surface_slugs",
    "authorization",
    "source_approval",
    "payload",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "protocol_refresh_public_handoff" },
    "refresh_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "family_slug": { "$ref": "#/$defs/slug" },
    "surface_slugs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "authorization": {
      "const": {
        "production_authorized": false,
        "explicit_production_approval_required": true
      }
    },
    "source_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_state", "accepted_changes_sha256", "status_sha256"],
      "properties": {
        "approval_state": { "const": "approved" },
        "accepted_changes_sha256": { "$ref": "#/$defs/sha256" },
        "status_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "payload": {
      "type": "object",
      "required": ["topology_contract"],
      "properties": {
        "topology_contract": { "$ref": "#/$defs/topologyContract" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "payload_sha256",
        "artifact_sha256"
      ],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "const": "sorted-keys-compact-ascii-json-v1" },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "topologyContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "canonical_surface_slugs",
        "canonical_surface_fingerprint",
        "operator_approval_artifact_sha256"
      ],
      "properties": {
        "mode": { "const": "preserve_canonical" },
        "canonical_surface_slugs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "canonical_surface_fingerprint": { "$ref": "#/$defs/sha256" },
        "operator_approval_artifact_sha256": { "type": "null" }
      }
    }
  }
}

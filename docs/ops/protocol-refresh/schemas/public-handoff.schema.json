{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://defirisk.co/schemas/protocol-refresh/public-handoff.schema.json",
  "title": "Non-authorizing public protocol refresh handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "refresh_id",
    "family_slug",
    "surface_slugs",
    "authorization",
    "source_approval",
    "payload",
    "integrity"
  ],
  "properties": {
    "schema_version": { "enum": ["1.1", "1.2", "1.3"] },
    "artifact_type": { "const": "protocol_refresh_public_handoff" },
    "refresh_id": { "$ref": "#/$defs/id" },
    "family_slug": { "$ref": "#/$defs/slug" },
    "surface_slugs": { "$ref": "#/$defs/surfaceSlugs" },
    "authorization": {
      "const": {
        "production_authorized": false,
        "explicit_production_approval_required": true
      }
    },
    "source_approval": { "$ref": "#/$defs/sourceApproval" },
    "payload": { "$ref": "#/$defs/payload" },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "payload_sha256",
        "artifact_sha256"
      ],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "const": "sorted-keys-compact-ascii-json-v1" },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "factorId": { "type": "string", "pattern": "^RD-F-(?!169$)[0-9]{3}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceApproval": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["approval_state", "accepted_changes_sha256", "status_sha256"],
          "properties": {
            "approval_state": { "const": "approved" },
            "accepted_changes_sha256": { "$ref": "#/$defs/sha256" },
            "status_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["approval_state", "accepted_changes_sha256", "status_sha256", "reissue"],
          "properties": {
            "approval_state": { "const": "approved" },
            "accepted_changes_sha256": { "$ref": "#/$defs/sha256" },
            "status_sha256": { "$ref": "#/$defs/sha256" },
            "reissue": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason", "prior_refresh_id", "prior_artifact_sha256", "compensation_proof_sha256"],
              "properties": {
                "reason": { "const": "compensated_production_attempt" },
                "prior_refresh_id": { "$ref": "#/$defs/id" },
                "prior_artifact_sha256": { "$ref": "#/$defs/sha256" },
                "compensation_proof_sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["approval_state", "accepted_changes_sha256", "status_sha256", "corrections"],
          "properties": {
            "approval_state": { "const": "approved" },
            "accepted_changes_sha256": { "$ref": "#/$defs/sha256" },
            "status_sha256": { "$ref": "#/$defs/sha256" },
            "reissue": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason", "prior_refresh_id", "prior_artifact_sha256", "compensation_proof_sha256"],
              "properties": {
                "reason": { "const": "compensated_production_attempt" },
                "prior_refresh_id": { "$ref": "#/$defs/id" },
                "prior_artifact_sha256": { "$ref": "#/$defs/sha256" },
                "compensation_proof_sha256": { "$ref": "#/$defs/sha256" }
              }
            },
            "corrections": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["refresh_id", "accepted_changes_sha256", "status_sha256", "target_keys"],
                "properties": {
                  "refresh_id": { "$ref": "#/$defs/id" },
                  "accepted_changes_sha256": { "$ref": "#/$defs/sha256" },
                  "status_sha256": { "$ref": "#/$defs/sha256" },
                  "target_keys": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "minItems": 5,
                      "maxItems": 5,
                      "items": {}
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "nullableSha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "date": { "type": "string", "format": "date" },
    "nullableText": { "type": ["string", "null"] },
    "fieldValue": { "type": ["string", "number", "boolean", "null"] },
    "surfaceSlugs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "topologyContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "canonical_surface_slugs",
        "canonical_surface_fingerprint",
        "operator_approval_artifact_sha256"
      ],
      "properties": {
        "mode": { "const": "preserve_canonical" },
        "canonical_surface_slugs": { "$ref": "#/$defs/surfaceSlugs" },
        "canonical_surface_fingerprint": { "$ref": "#/$defs/sha256" },
        "operator_approval_artifact_sha256": { "type": "null" }
      }
    },
    "fieldChanges": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/fieldValue" }
    },
    "protocolFieldChanges": {
      "allOf": [
        { "$ref": "#/$defs/fieldChanges" },
        {
          "propertyNames": {
            "enum": [
              "display_name", "description", "homepage_url", "github_org",
              "defillama_slug", "protocol_type", "primary_chain", "launched_at",
              "status", "has_active_incident", "total_value_secured_usd"
            ]
          }
        }
      ]
    },
    "familyFieldChanges": {
      "allOf": [
        { "$ref": "#/$defs/fieldChanges" },
        {
          "propertyNames": {
            "enum": [
              "display_name", "description", "homepage_url", "protocol_type",
              "primary_chain", "status", "has_active_incident", "legacy_caveat",
              "total_value_secured_usd"
            ]
          }
        }
      ]
    },
    "surfaceFieldChanges": {
      "allOf": [
        { "$ref": "#/$defs/fieldChanges" },
        {
          "propertyNames": {
            "enum": ["display_name", "status", "launched_at", "primary_chain", "tvs_usd", "scope_note"]
          }
        }
      ]
    },
    "deploymentFieldChanges": {
      "allOf": [
        { "$ref": "#/$defs/fieldChanges" },
        {
          "propertyNames": {
            "enum": ["anchor_address", "display_name", "tvs_usd", "tvs_share", "deployed_at"]
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_surfaces",
        "allowed_factor_ids",
        "allowed_protocol_fields",
        "allowed_family_fields",
        "allowed_surface_fields",
        "allowed_deployment_fields"
      ],
      "properties": {
        "allowed_surfaces": { "$ref": "#/$defs/surfaceSlugs" },
        "allowed_factor_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/factorId" }
        },
        "allowed_protocol_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["display_name", "description", "homepage_url", "github_org", "defillama_slug", "protocol_type", "primary_chain", "launched_at", "status", "has_active_incident", "total_value_secured_usd"] }
        },
        "allowed_family_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["display_name", "description", "homepage_url", "protocol_type", "primary_chain", "status", "has_active_incident", "legacy_caveat", "total_value_secured_usd"] }
        },
        "allowed_surface_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["display_name", "status", "launched_at", "primary_chain", "tvs_usd", "scope_note"] }
        },
        "allowed_deployment_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["anchor_address", "display_name", "tvs_usd", "tvs_share", "deployed_at"] }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_sha256", "other_protocols_sha256"],
      "properties": {
        "target_sha256": { "$ref": "#/$defs/sha256" },
        "other_protocols_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "surfaceChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_slug", "fields"],
      "properties": {
        "surface_slug": { "$ref": "#/$defs/slug" },
        "fields": { "$ref": "#/$defs/surfaceFieldChanges" }
      }
    },
    "deploymentChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_slug", "chain", "deployment_key", "fields"],
      "properties": {
        "surface_slug": { "$ref": "#/$defs/slug" },
        "chain": { "type": "string", "minLength": 1 },
        "deployment_key": { "type": "string", "minLength": 1 },
        "fields": { "$ref": "#/$defs/deploymentFieldChanges" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "reference"],
      "properties": {
        "source_type": { "enum": ["url", "github", "etherscan", "transaction", "audit_report", "governance_post", "docs", "partner_feed", "curator_note", "commit_sha"] },
        "url": { "$ref": "#/$defs/nullableText" },
        "reference": { "type": "string", "minLength": 1 },
        "title": { "$ref": "#/$defs/nullableText" },
        "retrieved_at": { "$ref": "#/$defs/nullableText" },
        "is_archived": { "type": ["boolean", "null"] },
        "archive_url": { "$ref": "#/$defs/nullableText" },
        "relation": { "const": "primary" }
      }
    },
    "factorScoreChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factor_id", "scope_level", "surface_slug", "chain", "deployment_key",
        "expected_current_sha256", "score", "evidence_summary", "collection_mode", "sources"
      ],
      "properties": {
        "factor_id": { "$ref": "#/$defs/factorId" },
        "scope_level": { "enum": ["family", "surface", "deployment"] },
        "surface_slug": { "oneOf": [{ "$ref": "#/$defs/slug" }, { "type": "null" }] },
        "chain": { "$ref": "#/$defs/nullableText" },
        "deployment_key": { "$ref": "#/$defs/nullableText" },
        "expected_current_sha256": { "$ref": "#/$defs/nullableSha256" },
        "score": { "enum": ["green", "yellow", "red", "gray", "not_assessed", "not_applicable"] },
        "evidence_summary": { "type": "string", "minLength": 1 },
        "evidence_detail": { "$ref": "#/$defs/nullableText" },
        "collection_mode": { "enum": ["programmatic", "manual", "hybrid"] },
        "gap_reason": { "$ref": "#/$defs/nullableText" },
        "data_as_of": { "$ref": "#/$defs/nullableText" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
      },
      "allOf": [
        {
          "if": { "properties": { "score": { "enum": ["not_assessed", "not_applicable"] } }, "required": ["score"] },
          "then": {},
          "else": { "properties": { "sources": { "minItems": 1 } } }
        }
      ]
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_fields", "family_fields", "surfaces", "deployments", "factor_scores"],
      "properties": {
        "protocol_fields": { "$ref": "#/$defs/protocolFieldChanges" },
        "family_fields": { "$ref": "#/$defs/familyFieldChanges" },
        "surfaces": { "type": "array", "items": { "$ref": "#/$defs/surfaceChange" } },
        "deployments": { "type": "array", "items": { "$ref": "#/$defs/deploymentChange" } },
        "factor_scores": { "type": "array", "items": { "$ref": "#/$defs/factorScoreChange" } }
      }
    },
    "surfaceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline_grade", "risk_score", "cap_state"],
      "properties": {
        "headline_grade": { "enum": ["A", "B", "C", "D", "F"] },
        "risk_score": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
        "cap_state": { "enum": ["none", "cap"] }
      }
    },
    "expectedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline_grade", "risk_score", "cap_state", "active_factor_count", "surface_results"],
      "properties": {
        "headline_grade": { "enum": ["A", "B", "C", "D", "F"] },
        "risk_score": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
        "cap_state": { "enum": ["none", "cap"] },
        "active_factor_count": { "type": "integer", "minimum": 0 },
        "surface_results": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/surfaceResult" }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "batch_id", "refresh_id", "family_slug", "protocol_slug",
        "surface_slugs", "refresh_type", "rubric_version", "effective_refresh_date",
        "topology_contract", "scope", "baseline", "expected_result", "changes"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "batch_id": { "$ref": "#/$defs/id" },
        "refresh_id": { "$ref": "#/$defs/id" },
        "family_slug": { "$ref": "#/$defs/slug" },
        "protocol_slug": { "$ref": "#/$defs/slug" },
        "surface_slugs": { "$ref": "#/$defs/surfaceSlugs" },
        "refresh_type": { "enum": ["full_family_refresh", "targeted_surface_update"] },
        "rubric_version": { "type": "string", "minLength": 1 },
        "effective_refresh_date": { "$ref": "#/$defs/date" },
        "topology_contract": { "$ref": "#/$defs/topologyContract" },
        "scope": { "$ref": "#/$defs/scope" },
        "baseline": { "$ref": "#/$defs/baseline" },
        "expected_result": { "$ref": "#/$defs/expectedResult" },
        "changes": { "$ref": "#/$defs/changes" }
      }
    }
  }
}
